create policy forge_account_admission_storage_select_restrictive
on storage.objects
as restrictive
for select
to authenticated
using (tongs.current_request_is_admitted());

create policy forge_account_admission_storage_insert_restrictive
on storage.objects
as restrictive
for insert
to authenticated
with check (tongs.current_request_is_admitted());

