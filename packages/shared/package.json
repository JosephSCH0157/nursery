{
  "name": "@forge/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "20.20.0" },
  "volta": { "node": "20.20.0" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./episode-workspace": {
      "types": "./dist/episode-workspace/index.d.ts",
      "import": "./dist/episode-workspace/index.js",
      "default": "./dist/episode-workspace/index.js"
    },
    "./henry": {
      "types": "./dist/henry/index.d.ts",
      "import": "./dist/henry/index.js",
      "default": "./dist/henry/index.js"
    },
    "./script-tags": {
      "types": "./dist/script-tags/index.d.ts",
      "import": "./dist/script-tags/index.js",
      "default": "./dist/script-tags/index.js"
    },
    "./hearth-visual-styles": {
      "types": "./dist/hearth-visual-styles.d.ts",
      "import": "./dist/hearth-visual-styles.js",
      "default": "./dist/hearth-visual-styles.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "types": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
