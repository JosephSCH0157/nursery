{
  "name": "@forge/tongs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "20.20.0" },
  "volta": { "node": "20.20.0" },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai-policy": {
      "types": "./src/ai-policy.ts",
      "import": "./dist/ai-policy.js",
      "default": "./dist/ai-policy.js"
    },
    "./ai-router": {
      "types": "./src/ai-router.ts",
      "import": "./dist/ai-router.js",
      "default": "./dist/ai-router.js"
    },
    "./ai-usage-taxonomy": {
      "types": "./src/ai-usage-taxonomy.ts",
      "import": "./dist/ai-usage-taxonomy.js",
      "default": "./dist/ai-usage-taxonomy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "dev:commit-api": "tsc -p tsconfig.json && node ./dev/commit-api-server.mjs",
    "migrate:cloud-role-roots": "tsc -p tsconfig.json && node ./dev/migrate-cloud-role-roots.mjs",
    "test:commit-api": "tsc -p tsconfig.json && node --test tests/workpiece-commit-api.test.mjs",
    "test:storage-registry": "tsc -p tsconfig.json && node --test tests/storage-registry-migration.test.mjs",
    "test": "tsc -p tsconfig.json && node --test tests/ai-policy.test.mjs tests/asset-variant-resolver.test.mjs tests/storage-registry-migration.test.mjs tests/workpiece-commit-api.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.57.2"
  },
  "dependencies": {
    "@forge/shared": "workspace:*",
    "@supabase/supabase-js": "^2.98.0",
    "fflate": "^0.8.2"
  }
}
