{
  "name": "@forge/tongs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "dev:commit-api": "npm run build && npm exec -- node ./dev/commit-api-server.mjs",
    "test:commit-api": "npm run build && npm exec -- node --test tests/workpiece-commit-api.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0"
  }
}
