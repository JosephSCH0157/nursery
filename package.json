{
  "name": "podcasters-forge",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter nursery dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter nursery lint && pnpm --filter @forge/tongs lint",
    "types": "pnpm --filter nursery typecheck && pnpm --filter @forge/tongs typecheck",
    "gate": "pnpm check",
    "check": "pnpm smoke && pnpm lint && pnpm types",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "graphemer": "1.4.0",
    "typescript": "^5.9.3"
  },
  "volta": {
    "node": "20.20.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0"
  }
}
