{
  "name": "teleprompter",
  "type": "module",
  "version": "1.8.5",
  "private": true,
  "engines": {
    "node": "20.20.0"
  },
  "volta": { "node": "20.20.0" },
  "scripts": {
    "lint": "node tools/run-eslint.mjs",
    "lint:strict": "node tools/run-eslint.mjs --max-warnings=0",
    "lint:fix": "node tools/run-eslint.mjs --fix",
    "dev": "pnpm exec live-server --port=8080 --no-browser --watch=. --ignore=node_modules,.git",
    "build:ts": "esbuild src/index.ts src/forge/login.ts src/forge/reset.ts src/display-renderer.ts src/net/display-ws-display-client.ts --bundle --format=esm --outdir=dist --outbase=src && node scripts/gen-esbuild-manifest.mjs",
    "build:compat": "esbuild adapters/bridge.ts adapters/obs.ts --bundle --format=esm --outdir=dist/adapters --platform=browser --banner:js=\"/* GENERATED FROM TypeScript - DO NOT EDIT. Edit adapters/*.ts instead. */\" && esbuild src/adapters/hotkey.ts --bundle --format=esm --outfile=dist/adapters/hotkey.js --platform=browser --banner:js=\"/* GENERATED FROM TypeScript - DO NOT EDIT. Edit src/adapters/*.ts instead. */\" && esbuild recorders.ts --bundle --format=esm --outdir=dist --platform=browser --banner:js=\"/* GENERATED FROM TypeScript - DO NOT EDIT. Edit recorders.ts instead. */\"",
    "build": "pnpm run build:ts && pnpm run build:compat && pnpm run build:speech && pnpm run build:hud && pnpm run build:asr && pnpm run build:display-relay && node tools/copy-static-to-dist.mjs && node tools/assert_dist_assets.mjs",
    "check:cycles": "madge --circular --extensions ts,tsx src/index.ts",
    "watch:ts": "esbuild src/index.ts --bundle --format=esm --sourcemap --outdir=dist --outbase=src --watch",
    "build:logic": "tsc -b src/logic",
    "build:asr": "pnpm exec esbuild src/index-hooks/asr.ts --bundle --format=esm --outfile=dist/index-hooks/asr.js",
    "watch:asr": "pnpm exec esbuild src/index-hooks/asr.ts --bundle --format=esm --sourcemap --outfile=dist/index-hooks/asr.js --watch",
    "build:router": "pnpm exec esbuild src/features/scroll-router.ts --bundle --format=esm --outfile=dist/features/scroll-router.js",
    "watch:router": "pnpm exec esbuild src/features/scroll-router.ts --bundle --format=esm --sourcemap --outfile=dist/features/scroll-router.js --watch",
    "typecheck": "pnpm run build:logic && tsc -p tsconfig.json --noEmit",
    "smoke": "node tools/smoke_test.js --calm --controlled --port=5181 --timeout=120000",
    "test:asr-smoke": "node tools/build_asr_smoke.mjs && node tools/asr_smoke.js",
    "test:rec-smoke": "node tools/rec_smoke.js",
    "lint:ts": "eslint \"**/*.{ts,tsx}\"",
    "lint:badchars": "node tools/check-bad-chars.mjs",
    "smoke:ci": "pnpm run build && node tools/teleprompter_e2e.js --runSmoke --stubObs --shimRecorder --headless",
    "smoke:strict": "pnpm run build && node tools/teleprompter_e2e.js --runSmoke --headless",
    "smoke:strict:slow": "node tools/teleprompter_e2e.js --runSmoke --timeout=60000 --headless",
    "ui:crawl": "node tools/teleprompter_e2e.js --crawl --headless",
    "ui:crawl:validate": "node tools/validate_ui_crawl.js",
    "ui:crawl:dev": "node tools/teleprompter_e2e.js --crawl --headless --dev",
    "types": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run lint && pnpm run types",
    "ci": "pnpm run check && pnpm run check:cycles && pnpm run smoke:strict",
    "smoke:rehearsal": "node tools/rehearsal_smoke.js",
    "smoke:hud": "pnpm run build && node tools/teleprompter_e2e.js --runSmoke --headless --timeout=45000 && node tools/hud_smoke.js",
    "smoke:reh_api": "node tools/rehearsal_api_smoke.js",
    "gate": "node tools/run-gate.mjs",
    "gate:quick": "pnpm run lint && pnpm run types && pnpm run smoke:strict",
    "smoke:fast": "node tools/build_asr_smoke.mjs && node tools/asr_smoke.js && node tools/rec_smoke.js",
    "test:save-ci": "node tools/test_save_ci.js",
    "test:obs-scene-ci": "node tools/test_obs_scene_ci.js",
    "test:asr-phase3-orchestrator-proof": "jest --config jest.config.cjs tests/ui/asr-phase3-orchestrator-proof.test.ts",
    "test:asr-phase3-orchestrator-sequence-proof": "jest --config jest.config.cjs tests/ui/asr-phase3-orchestrator-sequence-proof.test.ts",
    "test:asr-phase3-orchestrator-skipped-line-proof": "jest --config jest.config.cjs tests/ui/asr-phase3-orchestrator-skipped-line-proof.test.ts",
    "test:asr-phase3-orchestrator-stale-repeat-proof": "jest --config jest.config.cjs tests/ui/asr-phase3-orchestrator-stale-repeat-proof.test.ts",
    "test:asr-phase3-orchestrator-backward-target-proof": "jest --config jest.config.cjs tests/ui/asr-phase3-orchestrator-backward-target-proof.test.ts",
    "test:asr-phase3-orchestrator-nomatch-proof": "jest --config jest.config.cjs tests/ui/asr-phase3-orchestrator-nomatch-proof.test.ts",
    "test:asr-phase3-orchestrator-terminal-bounded-proof": "jest --config jest.config.cjs tests/ui/asr-phase3-orchestrator-terminal-bounded-proof.test.ts",
    "test:asr-phase3": "jest --config jest.config.cjs tests/ui/asr-phase3-orchestrator-proof.test.ts tests/ui/asr-phase3-orchestrator-sequence-proof.test.ts tests/ui/asr-phase3-orchestrator-skipped-line-proof.test.ts tests/ui/asr-phase3-orchestrator-stale-repeat-proof.test.ts tests/ui/asr-phase3-orchestrator-backward-target-proof.test.ts tests/ui/asr-phase3-orchestrator-nomatch-proof.test.ts tests/ui/asr-phase3-orchestrator-terminal-bounded-proof.test.ts --runInBand",
    "prepare": "pnpm run build:compat",
    "build:speech": "node tools/esbuild-speech.mjs",
    "watch:speech": "node tools/esbuild-speech.mjs --watch",
    "build:hud": "node tools/esbuild-hud.mjs",
    "watch:hud": "node tools/esbuild-hud.mjs --watch",
    "build:display-relay": "esbuild src/net/display-ws-server.ts --bundle --format=cjs --platform=node --target=es2022 --outfile=dist/net/display-ws-server.cjs",
    "coffee": "node -e \"console.log('☕ Coffee acquired. Proceed with violence.');\"",
    "gate:clean": "node tools/gate_clean.js",
    "postversion": "node tools/bump_html_version.js && git add teleprompter_pro.html && git commit -m \"chore(html): bump visible version\" || true",
    "test": "jest --config jest.config.cjs",
    "report:asr-alignment": "node tools/asr_alignment_report.mjs",
    "report:asr-trace": "node --experimental-strip-types tools/analyze_asr_trace.mjs",
    "check-index-shell": "node tools/check-index-shell.js",
    "ci-local": "pnpm run check && pnpm run smoke:strict"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "esbuild": "^0.27.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.3.2",
    "live-server": "1.2.2",
    "madge": "^8.0.0",
    "playwright": "^1.56.1",
    "prettier": "^3.8.1",
    "puppeteer": "^24.38.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@forge/shared": "workspace:*",
    "@supabase/supabase-js": "^2.98.0",
    "jszip": "^3.10.1",
    "obs-websocket-js": "5.0.8",
    "qrcode": "^1.5.1",
    "ws": "8.20.0"
  }
}
