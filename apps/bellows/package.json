{
  "name": "@forge/bellows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "20.20.0" },
  "volta": { "node": "20.20.0" },
  "description": "Bellows - Forge remote production studio",
  "license": "UNLICENSED",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "echo \"Bellows dev entry not wired yet\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "test:engine": "tsx --test tests/engine/reducer.test.ts",
    "test:runtime": "tsx --test tests/runtime/session-runtime.test.ts tests/runtime/studio-shell-harness.test.ts tests/runtime/persistence-harness.test.ts tests/runtime/operator-console-harness.test.ts tests/runtime/record-only-contract.test.ts",
    "test": "pnpm test:engine && pnpm test:runtime"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.57.2"
  }
}
