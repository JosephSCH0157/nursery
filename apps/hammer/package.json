    "node": "20.20.0"
  },
  "scripts": {
    "dev": "node -e \"console.log('Hammer runs through Nursery.')\"",
    "build": "pnpm --dir ../nursery run build:hammer-integration",
    "lint": "node scripts/check-lint-ratchet.mjs",
    "lint:report": "eslint src tests",
    "preview": "node -e \"console.log('Hammer previews through Nursery.')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "pnpm typecheck",
    "types:ratchet": "node scripts/check-type-safety-ratchet.mjs && node scripts/check-architecture-ratchet.mjs",
