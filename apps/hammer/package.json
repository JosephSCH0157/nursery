    "@eslint/js": "^9.39.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
