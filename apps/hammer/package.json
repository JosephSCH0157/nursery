    "test:runtime-data": "tsx tests/hammerRuntimeData.test.ts",
    "test:snapshot-artifacts": "tsx tests/hammerSnapshotArtifactApi.test.ts",
    "test:history-artifacts": "tsx tests/hammerHistoryArtifactApi.test.ts",
