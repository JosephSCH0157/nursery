    "test:workspace-transcript": "tsx tests/hammerWorkspaceTranscript.test.ts",
    "test:workspace-authority": "tsx tests/hammerWorkspaceAuthority.test.ts",
    "test:workspace-core": "pnpm run test:workspace-timeline && pnpm run test:workspace-transcript && pnpm run test:workspace-authority",
