    "types:test-boundary": "tsc -p tsconfig.test-boundary.json --noEmit",
    "test": "pnpm run test:all",
    "test:all": "pnpm run types:ratchet && node scripts/run-all-tests.mjs",
    "test:all:shuffled": "pnpm run types:ratchet && node scripts/run-all-tests.mjs --shuffle-seed=260710",
    "test:coverage:collect": "c8 node scripts/run-all-tests.mjs",
    "test:coverage": "pnpm run types:ratchet && pnpm run test:coverage:collect && node scripts/check-coverage-ratchet.mjs",
