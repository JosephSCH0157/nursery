{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@forge/tongs": ["../../packages/tongs/src/index.ts"],
      "@forge/shared": ["../../packages/shared/index.ts"],
      "@forge/shared/*": [
        "../../packages/shared/*.ts",
        "../../packages/shared/*/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/typescript/hammer-main.tsbuildinfo"
  },
  "include": ["src"]
}
