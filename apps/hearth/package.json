{
  "name": "@nursery/hearth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "20.20.0" },
  "volta": { "node": "20.20.0" },
  "scripts": {
    "test:all": "node scripts/run-tests.mjs",
    "build": "tsc -p tsconfig.json --noEmit",
    "types": "pnpm typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "types:test-boundary": "tsc -p tsconfig.stabilization-tests.json --noEmit",
    "test:stabilization": "node scripts/run-stabilization-tests.mjs",
    "gate:stabilization": "node scripts/run-stabilization-tests.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:confidence": "tsx tests/hearth-confidence.test.ts",
    "test:spark-entry-smoke": "tsx tests/hearth-spark-entry-smoke.test.ts",
    "test:broll-thumb-guard": "node tests/hearth-broll-thumb-guard.node.cjs",
    "test:ai-proposal": "tsx tests/hearth-ai-proposal.test.ts",
    "test:thumbnail-lint": "tsx tests/thumbnail-lint.test.ts",
    "test:thumbnail-ctr": "tsx tests/thumbnail-ctr-evaluator.test.ts",
    "test:thumbnail-v3": "tsx --test tests/episode-package-v3.test.ts"
  },
  "dependencies": {
    "@forge/shared": "workspace:*",
    "@forge/tongs": "workspace:*",
    "@forge/ui-mobile": "workspace:*",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "react-dom": "19.2.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
