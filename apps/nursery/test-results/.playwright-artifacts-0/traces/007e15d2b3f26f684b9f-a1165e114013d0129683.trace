x-height: calc(100vh - 32px);\r\n  overflow: auto;\r\n  background: rgba(13, 20, 35, 0.98);\r\n  border: 1px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 14px;\r\n  padding: 14px;\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.forge-ai-panel__learning-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n\r\n.forge-ai-panel__learning-title {\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n}\r\n\r\n.forge-ai-panel__learning-tabs {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.forge-ai-panel__learning-tabs button[data-active=\"1\"] {\r\n  border-color: rgba(147, 197, 253, 0.75);\r\n  background: rgba(147, 197, 253, 0.2);\r\n}\r\n\r\n.forge-ai-panel__learning-body {\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.forge-ai-panel__learning-section {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.forge-ai-panel__learning-textarea {\r\n  width: 100%;\r\n  min-height: 130px;\r\n  resize: vertical;\r\n}\r\n\r\n.forge-ai-panel__forge-list {\r\n  max-height: 220px;\r\n  overflow: auto;\r\n  border: 1px solid rgba(255, 255, 255, 0.14);\r\n  border-radius: 10px;\r\n  padding: 8px;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.forge-ai-panel__forge-item {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: flex-start;\r\n  font-size: 12px;\r\n  opacity: 0.92;\r\n}\r\n\r\n.forge-ai-panel__forge-item input {\r\n  margin-top: 2px;\r\n}\r\n\r\n.forge-ai-panel__learning-preview {\r\n  border-top: 1px solid rgba(255, 255, 255, 0.12);\r\n  padding-top: 10px;\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.forge-ai-panel__learning-list {\r\n  margin: 0;\r\n  padding-left: 18px;\r\n  display: grid;\r\n  gap: 10px;\r\n  font-size: 12px;\r\n}\r\n\r\n.forge-ai-panel__learning-item-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n\r\n.forge-ai-panel__learning-item-head button {\r\n  padding: 4px 8px;\r\n}\r\n\r\n.forge-ai-panel__learning-snippet {\r\n  opacity: 0.88;\r\n  line-height: 1.4;\r\n}\r\n\r\n.forge-ai-panel__learning-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n}\r\n"],["STYLE",{},":root {\n  --mobile-space-1: 4px;\n  --mobile-space-2: 8px;\n  --mobile-space-3: 12px;\n  --mobile-space-4: 16px;\n  --mobile-space-5: 20px;\n  --mobile-space-6: 24px;\n  --mobile-page-padding: 16px;\n  --mobile-tap-min: 44px;\n}\n\n.mobile-truncate {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.mobile-safe-top {\n  padding-top: env(safe-area-inset-top, 0px);\n}\n\n.mobile-safe-bottom {\n  padding-bottom: env(safe-area-inset-bottom, 0px);\n}\n\n.mobile-tap-target {\n  min-height: var(--mobile-tap-min);\n  min-width: var(--mobile-tap-min);\n}\n\n.mobile-stack {\n  display: grid;\n  gap: var(--mobile-space-4);\n}\n\n@media (max-width: 767px) {\n  button,\n  [role=\"button\"],\n  a.mobile-tap-target {\n    min-height: var(--mobile-tap-min);\n  }\n\n  input,\n  select,\n  textarea {\n    font-size: 16px;\n  }\n}\r\n"],["STYLE",{},".forge-login-page {\r\n  position: relative;\r\n  min-height: 100svh;\r\n  min-height: 100dvh;\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  align-items: center;\r\n  padding: 1.75rem clamp(1rem, 8vw, 8rem);\r\n  box-sizing: border-box;\r\n  overflow-x: hidden;\r\n  background:\r\n    radial-gradient(circle at 22% 42%, rgba(8, 20, 47, 0.2), rgba(1, 4, 12, 0.84)),\r\n    url(\"/anvil-login/assets/login.png\") center / cover no-repeat;\r\n}\r\n\r\n.forge-login-page::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  background: radial-gradient(circle at 26% 50%, rgba(2, 5, 12, 0.08), rgba(2, 5, 12, 0.72));\r\n  pointer-events: none;\r\n}\r\n\r\n.forge-login-page__brand {\r\n  position: absolute;\r\n  top: 1.25rem;\r\n  left: 1.5rem;\r\n  z-index: 2;\r\n  font-family: \"Cinzel Decorative\", \"Palatino Linotype\", serif;\r\n  font-weight: 700;\r\n  font-size: clamp(1.5rem, 1.4vw + 1rem, 2.4rem);\r\n  letter-spacing: 0.06em;\r\n  color: #f6f0e7;\r\n  text-shadow:\r\n    0 0 8px rgba(0, 0, 0, 0.7),\r\n    0 0 24px rgba(0, 0, 0, 0.45);\r\n  -webkit-user-select: none;\r\n  user-select: none;\r\n}\r\n\r\n.forge-login-page__brand span {\r\n  color: #f4cfa0;\r\n}\r\n\r\n.forge-login-page__video-shell {\r\n  position: absolute;\r\n  z-index: 1;\r\n  left: clamp(1rem, 4.5vw, 4rem);\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  width: min(40vw, 620px);\r\n  border-radius: 14px;\r\n  overflow: hidden;\r\n  border: 1px solid rgba(255, 255, 255, 0.16);\r\n  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);\r\n  aspect-ratio: 16 / 9;\r\n}\r\n\r\n.forge-login-page__video-shell iframe {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n  border: 0;\r\n}\r\n\r\n.forge-login-page__panel {\r\n  position: relative;\r\n  z-index: 2;\r\n  width: min(100%, 520px);\r\n}\r\n\r\n.forge-login-card {\r\n  max-width: 520px;\r\n  margin-left: auto;\r\n  background: rgba(10, 14, 28, 0.78);\r\n  border: 1px solid rgba(255, 255, 255, 0.18);\r\n  border-radius: 18px;\r\n  -webkit-backdrop-filter: blur(12px);\r\n  backdrop-filter: blur(12px);\r\n  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.62);\r\n  padding: 1.75rem;\r\n  color: #f7f7fb;\r\n}\r\n\r\n.forge-login-card__title {\r\n  margin: 0;\r\n  font-family: \"Cinzel Decorative\", \"Palatino Linotype\", serif;\r\n  letter-spacing: 0.03em;\r\n  font-size: 1.55rem;\r\n}\r\n\r\n.forge-login-card__subtitle {\r\n  margin: 0.5rem 0 0;\r\n  color: rgba(245, 247, 252, 0.94);\r\n}\r\n\r\n.forge-login-card__meta {\r\n  margin: 0.4rem 0 1rem;\r\n  font-size: 0.83rem;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  color: rgba(243, 206, 159, 0.92);\r\n}\r\n\r\n.forge-login-card__actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.65rem;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.forge-login-card__back,\r\n.forge-login-card__beta {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border-radius: 999px;\r\n  text-decoration: none;\r\n  font-weight: 600;\r\n}\r\n\r\n.forge-login-card__back {\r\n  padding: 0.42rem 0.88rem;\r\n  border: 1px solid rgba(255, 255, 255, 0.24);\r\n  color: #f4f7ff;\r\n  background: rgba(3, 6, 14, 0.38);\r\n}\r\n\r\n.forge-login-card__back:hover {\r\n  background: rgba(15, 24, 52, 0.7);\r\n}\r\n\r\n.forge-login-card__beta {\r\n  margin-left: auto;\r\n  padding: 0.56rem 1rem;\r\n  font-size: 0.78rem;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  border: 1px solid rgba(255, 255, 255, 0.32);\r\n  color: #19140d;\r\n  background: linear-gradient(135deg, #ffd56b, #ff950f);\r\n  box-shadow: 0 10px 25px rgba(255, 149, 15, 0.35);\r\n}\r\n\r\n.forge-login-card__beta:hover {\r\n  filter: brightness(1.04);\r\n}\r\n\r\n.forge-login-form {\r\n  display: grid;\r\n  gap: 0.75rem;\r\n}\r\n\r\n.forge-login-field {\r\n  display: grid;\r\n  gap: 0.35rem;\r\n}\r\n\r\n.forge-login-field span {\r\n  font-size: 0.84rem;\r\n  color: rgba(240, 244, 255, 0.9);\r\n}\r\n\r\n.forge-login-field input {\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n  padding: 0.68rem 0.76rem;\r\n  border-radius: 10px;\r\n  border: 1px solid rgba(255, 255, 255, 0.2);\r\n  background: rgba(1, 4, 12, 0.72);\r\n  color: #f8faff;\r\n}\r\n\r\n.forge-login-field input:focus {\r\n  outline: none;\r\n  border-color: rgba(244, 207, 160, 0.88);\r\n  box-shadow: 0 0 0 2px rgba(244, 207, 160, 0.22);\r\n}\r\n\r\n.forge-login-button {\r\n  width: 100%;\r\n  padding: 0.7rem 0.95rem;\r\n  border-radius: 10px;\r\n  border: 1px solid transparent;\r\n  font-size: 0.95rem;\r\n  font-weight: 650;\r\n  cursor: pointer;\r\n}\r\n\r\n.forge-login-button:disabled {\r\n  cursor: default;\r\n  opacity: 0.65;\r\n}\r\n\r\n.forge-login-button--primary {\r\n  color: #16120d;\r\n  background: linear-gradient(135deg, #d66a2e, #f4cfa0);\r\n  box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.28);\r\n}\r\n\r\n.forge-login-button--ghost {\r\n  color: #f4cfa0;\r\n  border-