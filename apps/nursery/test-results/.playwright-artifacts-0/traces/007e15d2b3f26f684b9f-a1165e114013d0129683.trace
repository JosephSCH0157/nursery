-wrap {\r\n  display: grid;\r\n  gap: 4px;\r\n}\r\n\r\n.hs-draft-title {\r\n  font-weight: 700;\r\n  font-size: 18px;\r\n}\r\n\r\n.hs-draft-updated {\r\n  font-size: 12px;\r\n  opacity: 0.65;\r\n}\r\n\r\n.hs-project-title {\r\n  display: grid;\r\n  gap: 6px;\r\n  flex: 1 1 360px;\r\n  max-width: 560px;\r\n}\r\n\r\n.hs-toolbar {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n}\r\n\r\n.hs-tone-control {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 12px;\r\n  opacity: 0.9;\r\n}\r\n\r\n.hs-tone-control select {\r\n  min-width: 180px;\r\n}\r\n\r\n.hs-status-text {\r\n  font-size: 12px;\r\n  opacity: 0.75;\r\n}\r\n\r\n.hs-count-text {\r\n  font-size: 12px;\r\n  opacity: 0.6;\r\n}\r\n\r\n.hs-autosave-warning {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 12px;\r\n  color: #a84308;\r\n}\r\n\r\n.hs-autosave-warning button {\r\n  font-size: 11px;\r\n  padding: 2px 8px;\r\n}\r\n\r\n.hs-field {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-field-label {\r\n  font-weight: 600;\r\n}\r\n\r\n.hs-field-label-muted {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-textarea-body {\r\n  min-height: 320px;\r\n  resize: vertical;\r\n  overflow: hidden;\r\n}\r\n\r\n.hs-textarea-small {\r\n  min-height: 70px;\r\n  resize: vertical;\r\n}\r\n\r\n.hs-textarea-medium {\r\n  min-height: 90px;\r\n  resize: vertical;\r\n}\r\n\r\n.hs-textarea-modal {\r\n  min-height: 90px;\r\n  resize: vertical;\r\n}\r\n\r\n.hs-sources-row {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n}\r\n\r\n.hs-sources-summary {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-chat-stage-controls {\r\n  display: grid;\r\n  gap: 4px;\r\n}\r\n\r\n.hs-manual-draft-controls {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n}\r\n\r\n.hs-draft-stage {\r\n  display: grid;\r\n  gap: 12px;\r\n  min-height: 62vh;\r\n  align-items: stretch;\r\n}\r\n\r\n.hs-draft-stage.has-script-panel {\r\n  grid-template-columns: minmax(0, 1.35fr) minmax(300px, 1fr);\r\n}\r\n\r\n.hs-ai-chat {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 10px;\r\n  padding: 10px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  background: var(--forge-bg-elevated, #fff);\r\n  min-height: 62vh;\r\n}\r\n\r\n.hs-ai-chat-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-ai-chat-title {\r\n  font-weight: 600;\r\n  font-size: 13px;\r\n}\r\n\r\n.hs-ai-chat-log {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 8px;\r\n  padding: 8px;\r\n  min-height: 240px;\r\n  max-height: none;\r\n  overflow-y: auto;\r\n  display: grid;\r\n  gap: 8px;\r\n  flex: 1 1 auto;\r\n}\r\n\r\n.hs-ai-chat-empty {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-ai-chat-msg {\r\n  display: grid;\r\n  gap: 4px;\r\n  font-size: 12px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.hs-ai-chat-msg.is-user .hs-ai-chat-content {\r\n  background: rgba(85, 119, 255, 0.08);\r\n}\r\n\r\n.hs-ai-chat-msg.is-assistant .hs-ai-chat-content {\r\n  background: rgba(15, 23, 42, 0.05);\r\n}\r\n\r\n.hs-ai-chat-role {\r\n  font-size: 11px;\r\n  opacity: 0.65;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.hs-ai-chat-content {\r\n  border-radius: 8px;\r\n  padding: 6px 8px;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.hs-ai-chat-compose {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: flex-end;\r\n}\r\n\r\n.mic-button {\r\n  border: none;\r\n  background: transparent;\r\n  cursor: pointer;\r\n  font-size: 18px;\r\n  transition: transform 0.1s ease;\r\n}\r\n\r\n.mic-button.listening {\r\n  color: #b00020;\r\n  transform: scale(1.1);\r\n}\r\n\r\n.mic-button.transcribing {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.stt-lane-select {\r\n  font-size: 12px;\r\n  margin-right: 6px;\r\n}\r\n\r\n.hs-ai-shortcut-row {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hs-ai-shortcut-row button {\r\n  font-size: 12px;\r\n  padding: 4px 8px;\r\n}\r\n\r\n.hs-production-mode-status {\r\n  font-size: 12px;\r\n  opacity: 0.75;\r\n}\r\n\r\n.hs-production-action-row {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hs-production-action-row button {\r\n  font-size: 12px;\r\n  padding: 4px 8px;\r\n}\r\n\r\n.hs-ai-chat-input {\r\n  flex: 1 1 auto;\r\n  width: 100%;\r\n  min-height: 52px;\r\n  resize: vertical;\r\n}\r\n\r\n.hs-ai-chat-inputWrap {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.hs-stt-inputPanel {\r\n  min-height: 52px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 10px;\r\n  background: var(--forge-bg-elevated, #fff);\r\n}\r\n\r\n.hs-stt-oscHost {\r\n  flex: 1;\r\n  min-width: 0;\r\n  height: 30px;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.hs-stt-oscCanvas {\r\n  width: 100%;\r\n  height: 100%;\r\n  border-radius: 999px;\r\n  opacity: 0.95;\r\n}\r\n\r\n.hs-stt-hint {\r\n  font-size: 12px;\r\n  opacity: 0.8;\r\n  white-space: nowrap;\r\n}\r\n\r\n.hs-script-panel {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 10px;\r\n  padding: 10px;\r\n  background: var(--forge-bg-elevated, #fff);\r\n  display: grid;\r\n  gap: 10px;\r\n  align-content: start;\r\n  min-height: 62vh;\r\n}\r\n\r\n.hs-script-panel-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  gap: 10px;\r\n}\r\n\r\n.hs-script-panel-title {\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n}\r\n\r\n.hs-script-panel-meta {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-textarea-script-panel {\r\n  min-height: 300px;\r\n  overflow: auto;\r\n}\r\n\r\n.hs-ai-proposal {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 8px;\r\n  padding: 8px;\r\n  display: grid;\r\n  gap: 8px;\r\n  background: rgba(15, 23, 42, 0.02);\r\n}\r\n\r\n.hs-ai-proposal-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-ai-proposal-title {\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n}\r\n\r\n.hs-ai-proposal-meta {\r\n  font-size: 11px;\r\n  opacity: 0.65;\r\n}\r\n\r\n.hs-ai-proposal-list {\r\n  display: grid;\r\n  gap: 8px;\r\n  max-height: 220px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.hs-ai-op-row {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 8px;\r\n  padding: 8px;\r\n  display: grid;\r\n  gap: 8px;\r\n  grid-template-columns: auto 1fr;\r\n  align-items: start;\r\n}\r\n\r\n.hs-ai-op-body {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-ai-op-title {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n\r\n.hs-ai-op-diff {\r\n  display: grid;\r\n  gap: 4px;\r\n}\r\n\r\n.hs-ai-op-diff pre {\r\n  margin: 0;\r\n  padding: 6px 8px;\r\n  border-radius: 6px;\r\n  background: rgba(15, 23, 42, 0.04);\r\n  font-size: 11px;\r\n  white-space: pre-wrap;\r\n  line-height: 1.35;\r\n}\r\n\r\n.hs-ai-proposal-actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hs-script-validation {\r\n  border: 1px solid #c95f2d;\r\n  background: rgba(201, 95, 45, 0.08);\r\n  border-radius: 10px;\r\n  padding: 10px;\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-script-validation-title {\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n}\r\n\r\n.hs-script-validation-subtitle {\r\n  font-size: 12px;\r\n  opacity: 0.8;\r\n}\r\n\r\n.hs-script-validation-report {\r\n  margin: 0;\r\n  border-radius: 8px;\r\n  padding: 8px;\r\n  background: rgba(15, 23, 42, 0.08);\r\n  white-space: pre-wrap;\r\n  font-size: 12px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.hs-script-validation-actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hs-planning {\r\n  display: grid;\r\n  gap: 16px;\r\n}\r\n\r\n.hs-planning-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.hs-planning-title {\r\n  font-weight: 700;\r\n  font-size: 18px;\r\n}\r\n\r\n.hs-planning-meta {\r\n  font-size: 12px;\r\n  opacity: 0.6;\r\n}\r\n\r\n.hs-decision-section {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-decision-title {\r\n  font-weight: 600;\r\n}\r\n\r\n.hs-decision-input-row {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hs-decision-input {\r\n  flex: 1 1 240px;\r\n}\r\n\r\n.hs-muted-text {\r\n  font-size: 13px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-muted-text-subtle {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-muted-text-small {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  opacity: 0.6;\r\n}\r\n\r\n.hs-decision-list {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-decision-card {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 8px;\r\n  padding: 8px;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-decision-time {\r\n  font-size: 11px;\r\n  opacity: 0.6;\r\n}\r\n\r\n.hs-decision-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.hs-sources-view {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.hs-revisions {\r\n  display: grid;\r\n  gap: 16px;\r\n}\r\n\r\n.hs-revisions-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.hs-revisions-title {\r\n  font-weight: 700;\r\n  font-size: 18px;\r\n}\r\n\r\n.hs-revisions-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(240px, 1fr) minmax(320px, 1.2fr);\r\n  gap: 12px;\r\n  align-items: start;\r\n}\r\n\r\n.hs-revision-list {\r\n  display: grid;\r\n  gap: 10px;\r\n  max-height: 520px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.hs-revision-card {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 6px;\r\n  padding: 8px;\r\n  background: transparent;\r\n}\r\n\r\n.hs-revision-card.is-active {\r\n  background: rgba(85, 119, 255, 0.08);\r\n}\r\n\r\n.hs-revision-card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  font-size: 12px;\r\n}\r\n\r\n.hs-revision-kind {\r\n  text-transform: capitalize;\r\n  opacity: 0.7;\r\n  padding: 2px 6px;\r\n  border-radius: 999px;\r\n  border: 1px solid rgba(148, 163, 184, 0.4);\r\n}\r\n\r\n.hs-revision-note {\r\n  font-size: 13px;\r\n  margin-top: 4px;\r\n}\r\n\r\n.hs-revision-actions {\r\n  display: flex;\r\n  gap: 6px;\r\n  margin-top: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hs-revision-detail {\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.hs-revision-detail-title {\r\n  font-weight: 600;\r\n}\r\n\r\n.hs-revision-meta {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-revision-label {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-revision-label-text {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-revision-preview {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-revision-preview-title {\r\n  font-weight: 600;\r\n}\r\n\r\n.hs-revision-diff-section {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-revision-diff-block {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-diff-label {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-diff-list {\r\n  display: grid;\r\n  gap: 4px;\r\n}\r\n\r\n.hs-diff-separator {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.hs-diff-row {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-diff-cell {\r\n  padding: 2px 4px;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.hs-diff-cell.is-removed,\r\n.hs-diff-cell.is-changed-left {\r\n  background: rgba(255, 138, 154, 0.18);\r\n}\r\n\r\n.hs-diff-cell.is-added,\r\n.hs-diff-cell.is-changed-right {\r\n  background: rgba(121, 226, 166, 0.18);\r\n}\r\n\r\n.hs-modal-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0, 0, 0, 0.65);\r\n  display: grid;\r\n  place-items: center;\r\n  padding: 16px;\r\n}\r\n\r\n.hs-modal {\r\n  width: min(460px, 90vw);\r\n  background: var(--forge-bg-elevated, #fff);\r\n  border-radius: 12px;\r\n  padding: 16px;\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.hs-modal-title {\r\n  font-weight: 700;\r\n}\r\n\r\n.hs-modal-actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.hs-mobile-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 80;\r\n  background: rgba(6, 11, 20, 0.95);\r\n}\r\n\r\n.hs-mobile-overlay-body {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.hs-mobile-overlay-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-thumb-panel {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 10px;\r\n  padding: 12px;\r\n  display: grid;\r\n  gap: 12px;\r\n  background: rgba(15, 23, 42, 0.02);\r\n}\r\n\r\n.hs-thumb-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-thumb-title {\r\n  font-weight: 700;\r\n}\r\n\r\n.hs-thumb-meta {\r\n  font-size: 12px;\r\n  opacity: 0.75;\r\n}\r\n\r\n.hs-thumb-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(220px, 300px) minmax(0, 1fr);\r\n  gap: 12px;\r\n}\r\n\r\n.hs-thumb-concepts {\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.hs-thumb-section-title {\r\n  font-size: 12px;\r\n  text-transform: uppercase;\r\n  opacity: 0.65;\r\n}\r\n\r\n.hs-thumb-concepts-list {\r\n  display: grid;\r\n  gap: 6px;\r\n  max-height: 180px;\r\n  overflow: auto;\r\n}\r\n\r\n.hs-thumb-concept-item {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 8px;\r\n  padding: 6px 8px;\r\n  background: transparent;\r\n  text-align: left;\r\n}\r\n\r\n.hs-thumb-concept-item.is-selected {\r\n  border-color: #557;\r\n  background: rgba(85, 119, 255, 0.08);\r\n}\r\n\r\n.hs-thumb-concept-editor {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-thumb-concept-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-thumb-preview-wrap {\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.hs-thumb-controls {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-thumb-file-input {\r\n  display: none;\r\n}\r\n\r\n.hs-thumb-preview {\r\n  position: relative;\r\n  min-height: 190px;\r\n  border: 1px dashed var(--forge-border, #bbb);\r\n  border-radius: 8px;\r\n  display: grid;\r\n  place-items: center;\r\n  overflow: hidden;\r\n  background: rgba(15, 23, 42, 0.04);\r\n}\r\n\r\n.hs-thumb-preview-empty {\r\n  font-size: 12px;\r\n  opacity: 0.75;\r\n  padding: 10px;\r\n}\r\n\r\n.hs-thumb-preview-image {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;\r\n}\r\n\r\n.hs-thumb-safe-zone {\r\n  display: none;\r\n  position: absolute;\r\n  inset: 8%;\r\n  border: 2px dashed rgba(255, 255, 255, 0.8);\r\n  box-shadow: 0 0 0 9999px rgba(15, 23, 42, 0.08);\r\n  pointer-events: none;\r\n}\r\n\r\n.hs-thumb-preview.show-safe-zone .hs-thumb-safe-zone {\r\n  display: block;\r\n}\r\n\r\n.hs-thumb-versions {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-thumb-versions-list {\r\n  display: grid;\r\n  gap: 8px;\r\n  max-height: 260px;\r\n  overflow: auto;\r\n}\r\n\r\n.hs-thumb-version-card {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 8px;\r\n  padding: 8px;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-thumb-version-card.is-selected {\r\n  border-color: #557;\r\n  background: rgba(85, 119, 255, 0.08);\r\n}\r\n\r\n.hs-thumb-version-card.is-primary {\r\n  border-color: rgba(22, 163, 74, 0.65);\r\n}\r\n\r\n.hs-thumb-version-card.is-failed {\r\n  border-color: rgba(176, 0, 32, 0.45);\r\n}\r\n\r\n.hs-thumb-version-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-thumb-version-title {\r\n  font-weight: 600;\r\n}\r\n\r\n.hs-thumb-version-meta {\r\n  font-size: 12px;\r\n  opacity: 0.75;\r\n}\r\n\r\n.hs-thumb-version-status {\r\n  font-size: 11px;\r\n  border-radius: 999px;\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  padding: 1px 8px