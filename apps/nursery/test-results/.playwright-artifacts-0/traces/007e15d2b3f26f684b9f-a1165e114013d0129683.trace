nt-size: 11px;\r\n  padding: 1px 6px;\r\n  border-radius: 999px;\r\n  border: 1px solid rgba(148, 163, 184, 0.6);\r\n  color: rgba(15, 23, 42, 0.7);\r\n  background: rgba(15, 23, 42, 0.08);\r\n}\r\n\r\n.hs-sources-badge.is-dev {\r\n  color: #b00020;\r\n  background: rgba(176, 0, 32, 0.08);\r\n}\r\n\r\n.hs-main {\r\n  display: grid;\r\n  gap: 16px;\r\n}\r\n\r\n.hs-main--mobile {\r\n  gap: 12px;\r\n}\r\n\r\n.hs-home {\r\n  display: grid;\r\n  gap: 20px;\r\n}\r\n\r\n.hs-sparks-landing {\r\n  gap: 14px;\r\n}\r\n\r\n.hs-home-header {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-home-title {\r\n  margin: 0;\r\n}\r\n\r\n.hs-home-subtext {\r\n  margin: 0;\r\n  opacity: 0.75;\r\n}\r\n\r\n.hs-home-section {\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.hs-home-section-title {\r\n  margin: 0;\r\n  font-size: 16px;\r\n}\r\n\r\n.hs-home-actions {\r\n  display: flex;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hs-resume-context {\r\n  font-size: 12px;\r\n  opacity: 0.75;\r\n}\r\n\r\n.hs-project-intake {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-project-intake-actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n}\r\n\r\n.hs-project-intake-meta {\r\n  font-size: 12px;\r\n  opacity: 0.75;\r\n}\r\n\r\n.hs-project-intake-stack {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-project-intake-spark {\r\n  font-size: 12px;\r\n  opacity: 0.88;\r\n}\r\n\r\n.hs-error-text {\r\n  color: #b00020;\r\n  font-size: 14px;\r\n}\r\n\r\n.hs-error-text-small {\r\n  color: #b00020;\r\n  font-size: 12px;\r\n}\r\n\r\n.hs-home-barstock {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.hs-sparks-layout {\r\n  display: grid;\r\n  gap: 14px;\r\n  grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);\r\n  align-items: start;\r\n}\r\n\r\n.hs-home-empty {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-home-spark-list {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.hs-spark-card {\r\n  border: 1px sol