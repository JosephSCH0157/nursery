th-day-more {\n  font-size: 12px;\n  opacity: 0.6;\n}\n\n.tongs-calendar__events {\n  margin-top: 16px;\n  display: grid;\n  gap: 8px;\n}\n\n.tongs-calendar__events-title {\n  margin: 0;\n}\n\n.tongs-calendar__events-list {\n  display: grid;\n  gap: 10px;\n}\n\n.tongs-calendar__events-row {\n  padding: 12px;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  border-radius: 8px;\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.tongs-calendar__events-row-main {\n  display: grid;\n  gap: 4px;\n}\n\n.tongs-calendar__events-row-title {\n  font-weight: 600;\n}\n\n.tongs-calendar__events-row-time {\n  opacity: 0.75;\n  font-size: 13px;\n}\n\n.tongs-calendar__events-row-meta {\n  font-size: 12px;\n  opacity: 0.7;\n}\n\n.tongs-calendar__events-row-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.tongs-calendar__agenda-groups {\n  display: grid;\n  gap: 14px;\n}\n\n.tongs-calendar__agenda-group {\n  display: grid;\n  gap: 8px;\n}\n\n.tongs-calendar__agenda-group-title {\n  font-size: 13px;\n  font-weight: 700;\n  opacity: 0.82;\n}\n\n.tongs-calendar__agenda-list {\n  display: grid;\n  gap: 8px;\n}\n\n.tongs-calendar__agenda-row {\n  min-height: 44px;\n  width: 100%;\n  padding: 12px;\n  border: 1px solid rgba(255, 255, 255, 0.16);\n  border-radius: 10px;\n  background: rgba(255, 255, 255, 0.08);\n  text-align: left;\n  display: grid;\n  gap: 4px;\n}\n\n.tongs-calendar__agenda-row-title {\n  font-weight: 700;\n}\n\n.tongs-calendar__agenda-row-time {\n  font-size: 12px;\n  opacity: 0.82;\n}\n\n.tongs-calendar__agenda-row-meta {\n  font-size: 12px;\n  opacity: 0.72;\n}\n\n.tongs-calendar__storage {\n  margin-top: 14px;\n  font-size: 12px;\n  opacity: 0.65;\n}\n\n.tongs-calendar__mobile-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 1200;\n  background: var(--forge-bg);\n}\n\n.tongs-calendar__mobile-form {\n  display: grid;\n  gap: 12px;\n}\n\n.tongs-calendar__mobile-actions {\n  display: flex;\n  justify-content: flex-end;\