face: rgba(17, 27, 45, 0.78);\n  --barstock-surface-strong: rgba(26, 38, 61, 0.9);\n  --barstock-border: rgba(148, 163, 184, 0.3);\n  --barstock-text: var(--forge-text, #e5edf7);\n  --barstock-muted: var(--forge-text-muted, #9fb0c6);\n  --barstock-link: var(--forge-link, #93c5fd);\n  --barstock-link-hover: var(--forge-link-hover, #bfdbfe);\n  color: var(--barstock-text);\n}\n\n.barstock-root a {\n  color: var(--barstock-link);\n}\n\n.barstock-root a:hover {\n  color: var(--barstock-link-hover);\n}\n\n.barstock-root input,\n.barstock-root select,\n.barstock-root textarea {\n  border: 1px solid var(--barstock-border);\n  border-radius: 10px;\n  background: var(--barstock-surface);\n  color: var(--barstock-text);\n}\n\n.barstock-root input::placeholder,\n.barstock-root textarea::placeholder {\n  color: rgba(159, 176, 198, 0.9);\n}\n\n.barstock-root button {\n  border: 1px solid var(--barstock-border);\n  border-radius: 10px;\n  background: var(--barstock-surface-strong);\n  color: var(--barstock-text);\n}\n\n.barstock-root button:hover:not(:disabled) {\n  border-color: rgba(147, 197, 253, 0.55);\n  background: #243454;\n}\n\n.barstock-mobile-root {\n  min-height: 100dvh;\n  background: var(--barstock-bg);\n}\n\n.barstock-mobile-content {\n  display: grid;\n  gap: 12px;\n}\n\n.barstock-mobile-toast {\n  padding: 8px 10px;\n  border: 1px solid var(--barstock-border);\n  border-radius: 10px;\n  background: var(--barstock-surface);\n  font-size: 13px;\n}\n\n.barstock-mobile-message {\n  margin: 0;\n  opacity: 0.82;\n  font-size: 13px;\n}\n\n.barstock-mobile-count {\n  margin: 0;\n  font-size: 13px;\n  opacity: 0.82;\n}\n\n.barstock-mobile-field {\n  display: grid;\n  gap: 6px;\n}\n\n.barstock-mobile-field__label {\n  font-size: 12px;\n  opacity: 0.78;\n}\n\n.barstock-mobile-field > input,\n.barstock-mobile-field > select,\n.barstock-mobile-field > textarea {\n  width: 100%;\n  min-height: 44px;\n  font-size: 16px;\n  padding: 10px 12px;\n}\n\n.barstock-mobile-textarea {\n  width: 100%;\n  min-height: 180px;\n  resize: vertical;\n}\n\n.barstock-mobile-checkbox {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  opacity: 0.88;\n}\n\n.barstock-mobile-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  font-size: 12px;\n  opacity: 0.76;\n}\n\n.barstock-mobile-detail-body {\n  margin: 0;\n  border: 1px solid var(--barstock-border);\n  border-radius: 10px;\n  background: var(--barstock-surface);\n  padding: 12px;\n  white-space: pre-wrap;\n  font-family: inherit;\n  line-height: 1.45;\n}\n\n.barstock-mobile-list {\n  display: grid;\n  gap: 8px;\n}\n\n.barstock-mobile-spark-row {\n  width: 100%;\n  display: grid;\n  gap: 6px;\n  text-align: left;\n  border: 1px solid var(--barstock-border);\n  border-radius: 12px;\n  background: var(--barstock-surface);\n  color: var(--barstock-text);\n  min-height: 44px;\n  padding: 12px;\n}\n\n.barstock-mobile-spark-row__meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  font-size: 12px;\n  opacity: 0.75;\n}\n\n.barstock-mobile-spark-row__body {\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  line-height: 1.4;\n}\n\n.barstock-mobile-actions {\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n}\n\n.barstock-mobile-button {\n  min-height: 44px;\n  padding: 0 14px;\n  font-size: 14px;\n}\n\n.barstock-mobile-button--primary {\n  font-weight: 700;\n}\n\n.barstock-mobile-button--danger {\n  color: #ffd6d6;\n  border-color: rgba(255, 107, 107, 0.5);\n}\n\n.barstock-mobile-fallback {\n  min-height: 100dvh;\n  display: flex;\n  flex-direction: column;\n}\n\n.barstock-mobile-fallback__header {\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  gap: 8px;\n  align-items: center;\n  padding: 12px 14px;\n  border-bottom: 1px solid var(--barstock-border);\n  background: rgba(11, 18, 32, 0.95);\n}\n\n.barstock-mobile-fallback__left,\n.barstock-mobile-fallback__right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.barstock-mobile-fallback__title {\n  margin: 0;\n  text-align: center;\n  font-size: 17px;\n}\n\n.barstock-mobile-fallback__body {\n  flex: 1;\n  overflow: auto;\n  padding: 14px;\n}\n\n.barstock-mobile-fallback__bottom {\n  position: sticky;\n  bottom: 0;\n  border-top: 1px solid var(--barstock-border);\n  background: rgba(11, 18, 32, 0.95);\n  padding: 10px 14px;\n}\n"],["STYLE",{},".barstock-layout {\r\n  display: grid;\r\n  grid-template-columns: 260px 1fr;\r\n  min-height: 100vh;\r\n  font-family: system-ui, sans-serif;\r\n  color: var(--barstock-text);\r\n  background: var(--barstock-bg);\r\n}\r\n\r\n.barstock-sidebar {\r\n  border-right: 1px solid var(--barstock-border);\r\n  padding: 14px;\r\n}\r\n\r\n.barstock-sidebar__title {\r\n  font-weight: 800;\r\n  font-size: 18px;\r\n}\r\n\r\n.barstock-sidebar__summary {\r\n  opacity: 0.75;\r\n  margin-top: 6px;\r\n  font-size: 13px;\r\n}\r\n\r\n.barstock-workspace-row {\r\n  margin-top: 12px;\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.barstock-workspace-user {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n\r\n.barstock-workspace-email {\r\n  opacity: 0.7;\r\n}\r\n\r\n.barstock-workspace-muted {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.barstock-workspace-controls {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n\r\n.barstock-workspace-select,\r\n.barstock-workspace-input {\r\n  padding: 6px;\r\n  font-size: 12px;\r\n}\r\n\r\n.barstock-sidebar__section {\r\n  margin-top: 14px;\r\n}\r\n\r\n.barstock-sidebar__section-title {\r\n  font-weight: 700;\r\n  font-size: 13px;\r\n  opacity: 0.85;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.barstock-sidebar__project-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.barstock-sidebar__separator {\r\n  margin-top: 10px;\r\n  opacity: 0.7;\r\n  font-size: 12px;\r\n}\