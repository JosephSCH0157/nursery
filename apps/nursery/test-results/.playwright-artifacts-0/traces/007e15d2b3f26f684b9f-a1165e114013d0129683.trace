d;\n  gap: var(--mobile-space-3);\n}\n\n.mpd-heading {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 650;\n}\n\n.mpd-copy {\n  margin: 0;\n  color: var(--forge-text-muted);\n  line-height: 1.4;\n}\n\n.mpd-field {\n  display: grid;\n  gap: var(--mobile-space-2);\n  font-size: 13px;\n}\n\n.mpd-field span {\n  color: var(--forge-text-muted);\n}\n\n.mpd-bottom-actions {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  gap: var(--mobile-space-2);\n}\n\n.mpd-button {\n  border-radius: 10px;\n  border: 1px solid var(--forge-border);\n  padding: 0 14px;\n  min-height: var(--mobile-tap-min);\n}\n\n.mpd-button--ghost {\n  background: transparent;\n}\n\n.mpd-button--primary {\n  background: var(--forge-link);\n  color: #0a1020;\n  border-color: transparent;\n  font-weight: 600;\n}\r\n"],["STYLE",{},".hammer-project-library {\n  display: grid;\n  gap: 18px;\n  color: #dbe8ff;\n}\n\n.hammer-project-library__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n  flex-wrap: wrap;\n  padding: 18px;\n  border-radius: 18px;\n  border: 1px solid rgba(148, 163, 184, 0.24);\n  background: linear-gradient(160deg, rgba(15, 23, 42, 0.92), rgba(2, 6, 23, 0.94));\n}\n\n.hammer-project-library__intro {\n  display: grid;\n  gap: 6px;\n  max-width: 720px;\n}\n\n.hammer-project-library__eyebrow {\n  font-size: 12px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  opacity: 0.64;\n}\n\n.hammer-project-library__title {\n  margin: 0;\n  font-size: 30px;\n}\n\n.hammer-project-library__summary {\n  font-size: 14px;\n  line-height: 1.5;\n  opacity: 0.78;\n}\n\n.hammer-project-library__actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.hammer-project-library__button {\n  border-radius: 10px;\n  padding: 10px 14px;\n  font-weight: 600;\n  cursor: pointer;\n  color: #dbe8ff;\n}\n\n.hammer-project-library__button:disabled {\n  opacity: 0.58;\n  cursor: not-allowed;\n}\n\n.hammer-project-library__button--primary {\n  border: 1px solid rgba(96, 165, 250, 0.62);\n  background: rgba(59, 130, 246, 0.18);\n}\n\n.hammer-project-library__button--secondary {\n  border: 1px solid rgba(148, 163, 184, 0.32);\n  background: rgba(15, 23, 42, 0.72);\n}\n\n.hammer-project-library__section {\n  display: grid;\n  gap: 12px;\n}\n\n.hammer-project-library__section-title {\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.hammer-project-library__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 16px;\n}\n\n.hammer-project-library__card {\n  border-radius: 18px;\n  border: 1px solid rgba(148, 163, 184, 0.24);\n  background: rgba(15, 23, 42, 0.76);\n  overflow: hidden;\n  display: grid;\n  gap: 0;\n  cursor: pointer;\n  text-align: left;\n  color: #dbe8ff;\n  box-shadow: none;\n}\n\n.hammer-project-library__card.is-selected {\n  border-color: rgba(96, 165, 250, 0.72);\n  box-shadow: 0 16px 32px rgba(37, 99, 235, 0.14);\n}\n\n.hammer-project-library__poster {\n  min-height: 148px;\n  display: grid;\n  place-items: center;\n  padding: 18px;\n  font-size: 24px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n}\n\n.hammer-project-library__card-body {\n  display: grid;\n  gap: 8px;\n  padding: 14px;\n}\n\n.hammer-project-library__card-title {\n  font-size: 16px;\n  font-weight: 700;\n}\n\n.hammer-project-library__card-summary {\n  font-size: 12px;\n  opacity: 0.72;\n}\n"],["STYLE",{},".hammer-editor-shell {\n  display: grid;\n  grid-template-rows: minmax(0, 1fr) minmax(220px, 0.42fr);\n  gap: 10px;\n  min-height: calc(100vh - 138px);\n  align-items: stretch;\n}\n\n.hammer-editor-shell__upper-wrap {\n  min-height: 0;\n  overflow-x: auto;\n  overflow-y: hidden;\n}\n\n.hammer-editor-shell__upper {\n  display: grid;\n  gap: 0;\n  align-items: stretch;\n  min-height: 100%;\n}\n\n.hammer-pane {\n  border: 1px solid rgba(148, 163, 184, 0.28);\n  border-radius: 12px;\n  background: rgba(15, 23, 38, 0.74);\n  display: grid;\n  align-content: start;\n  min-height: 0;\n  min-width: 0;\n  overflow: hidden;\n  padding: 10px;\n  gap: 10px;\n}\n\n.hammer-pane--left,\n.hammer-pane--center {\n  display: grid;\n}\n\n.hammer-pane--right {\n  display: grid;\n  gap: 10px;\n  align-content: start;\n  overflow: auto;\n}\n\n.hammer-pane--tool-strip {\n  padding: 10px;\n  gap: 10px;\n  align-content: start;\n}\n\n.hammer-pane--timeline {\n  min-height: 0;\n}\n\n.hammer-pane-section {\n  border: 1px dashed rgba(148, 163, 184, 0.35);\n  border-radius: 12px;\n  padding: 8px 10px;\n  display: grid;\n  gap: 8px;\n  min-height: 0;\n  background: rgba(2, 6, 23, 0.45);\n  color: #c8d6ea;\n}\n\n.hammer-pane-section__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.hammer-pane-section__title-wrap {\n  display: grid;\n  gap: 3px;\n}\n\n.hammer-pane-section__title {\n  margin: 0;\n  font-size: 16px;\n  color: #dbe8ff;\n}\n\n.hammer-pane-section__subtitle {\n  font-size: 11px;\n  line-height: 1.35;\n  opacity: 0.72;\n  max-width: 560px;\n}\n\n.hammer-pane-section__body {\n  display: grid;\n  gap: 8px;\n  min-height: 0;\n}\n\n.hammer-pill {\n  border-radius: 999px;\n  padding: 2px 8px;\n  border: 1px solid rgba(148, 163, 184, 0.24);\n  background: rgba(15, 23, 42, 0.55);\n  color: #dbe8ff;\n}\n\n.hammer-pill--dirty {\n  background: rgba(245, 158, 11, 0.16);\n  color: #fde68a;\n}\n\n.hammer-pill--reloaded {\n  background: rgba(14, 165, 233, 0.16);\n  color: #bae6fd;\n}\n\n.hammer-pill--playing {\n  background: rgba(20, 184, 166, 0.16);\n  color: #99f6e4;\n}\n\n.hammer-meta-strip {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n  font-size: 12px;\n}\n\n.hammer-action-row,\n.hammer-tab-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.hammer-inspector-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 8px;\n}\n\n.hammer-mono {\n  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n}\n\n.hammer-toggle-button {\n  border-radius: 999px;\n  border: 1px solid rgba(148, 163, 184, 0.28);\n  background: rgba(15, 23, 42, 0.64);\n  color: #c8d6ea;\n  padding: 6px 12px;\n  font-size: 12px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: border-color 140ms ease, background 140ms ease, color 140ms ease, box-shadow 140ms ease;\n}\n\n.hammer-toggle-button:hover {\n  border-color: rgba(96, 165, 250, 0.38);\n  color: #dbe8ff;\n}\n\n.hammer-toggle-button.is-active {\n  background: rgba(59, 130, 246, 0.2);\n  color: #dbe8ff;\n}\n\n.hammer-toggle-button:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.32);\n}\n\n.hammer-editor-shell__divider {\n  border: none;\n  border-radius: 999px;\n  background: rgba(30, 41, 59, 0.92);\n  box-shadow: inset 0 0 0 1px rgba(148, 163, 184, 0.18);\n  cursor: col-resize;\n  padding: 0;\n  min-height: 0;\n}\n\n.hammer-editor-shell__divider.is-active {\n  background: rgba(59, 130, 246, 0.16);\n  box-shadow: inset 0 0 0 1px rgba(96, 165, 250, 0.54);\n}\n\n.hammer-tool-button {\n  border-radius: 14px;\n  border: 1px solid rgba(148, 163, 184, 0.24);\n  background: rgba(15, 23, 42, 0.7);\n  color: #c8d6ea;\n  display: grid;\n  gap: 4px;\n  padding: 10px 8px;\n  cursor: pointer;\n  text-align: center;\n  transition: border-color 140ms ease, background 140ms ease, color 140ms ease, transform 140ms ease;\n}\n\n.hammer-tool-button:hover {\n  border-color: rgba(96, 165, 250, 0.36);\n  color: #dbe8ff;\n  transform: translateY(-1px);\n}\n\n.hammer-tool-button.is-active {\n  background: rgba(59, 130, 246, 0.22);\n  color: #dbe8ff;\n}\n\n.hammer-tool-button:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.32);\n}\n\n.hammer-tool-strip__head {\n  display: grid;\n  gap: 4px;\n  justify-items: center;\n}\n\n.hammer-tool-strip__title {\n  color: #dbe8ff;\n  font-size: 12px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.hammer-tool-strip__caption {\n  font-size: 11px;\n  opacity: 0.62;\n  text-align: center;\n}\n\n.hammer-copy-sm {\n  font-size: 12px;\n}\n\n.hammer-copy-md {\n  font-size: 13px;\n}\n\n.hammer-copy-lg {\n  font-size: 16px;\n  color: #dbe8ff;\n}\n\n.hammer-copy-muted {\n  opacity: 0.72;\n}\n\n.hammer-copy-dim {\n  opacity: 0.78;\n}\n\n.hammer-copy-warning {\n  color: #fde68a;\n}\n\n.hammer-copy-error {\n  color: #fecaca;\n}\n\n.hammer-copy-success {\n  color: #a7f3d0;\n}\n\n.hammer-copy-strong {\n  color: #dbe8ff;\n}\n\n.hammer-label {\n  font-size: 11px;\n  opacity: 0.62;\n}\n\n.hammer-stack-4 {\n  display: grid;\n  gap: 4px;\n}\n\n.hammer-stack-6 {\n  display: grid;\n  gap: 6px;\n}\n\n.hammer-stack-10 {\n  display: grid;\n  gap: 10px;\n}\n\n.hammer-inline-list {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.hammer-inline-list-wide {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.hammer-button-xs {\n  border-radius: 10px;\n  border: 1px solid rgba(148, 163, 184, 0.24);\n  background: rgba(15, 23, 42, 0.72);\n  color: #dbe8ff;\n  padding: 5px 9px;\n  font-size: 12px;\n  cursor: pointer;\n  transition: border-color 140ms ease, background 140ms ease, box-shadow 140ms ease;\n}\n\n.hammer-button-xs:hover:not(:disabled) {\n  border-color: rgba(96, 165, 250, 0.4);\n  background: rgba(30, 41, 59, 0.92);\n}\n\n.hammer-button-xs:disabled {\n  opacity: 0.52;\n  cursor: not-allowed;\n}\n\n.hammer-button-xs:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.32);\n}\n\n.hammer-staged-edits {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 12px;\n  background: rgba(15, 23, 42, 0.48);\n  padding: 12px;\n  display: grid;\n  gap: 12px;\n}\n\n.hammer-staged-edits__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.hammer-staged-edits__title {\n  color: #dbe8ff;\n  font-size: 15px;\n}\n\n.hammer-staged-edits__empty {\n  border: 1px dashed rgba(148, 163, 184, 0.24);\n  border-radius: 10px;\n  background: rgba(2, 6, 23, 0.34);\n  padding: 14px 12px;\n  display: grid;\n  gap: 6px;\n}\n\n.hammer-staged-edits__groups {\n  display: grid;\n  gap: 12px;\n}\n\n.hammer-staged-edits__group {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 12px;\n  background: rgba(2, 6, 23, 0.34);\n  display: grid;\n  gap: 0;\n  overflow: hidden;\n}\n\n.hammer-staged-edits__group-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 10px 12px;\n  border-bottom: 1px solid rgba(148, 163, 184, 0.14);\n  background: rgba(15, 23, 42, 0.42);\n}\n\n.hammer-staged-edits__group-title {\n  font-size: 12px;\n  font-weight: 700;\n  color: #dbe8ff;\n}\n\n.hammer-staged-edits__group-count {\n  border-radius: 999px;\n  border: 1px solid rgba(148, 163, 184, 0.2);\n  background: rgba(15, 23, 42, 0.64);\n  color: #c8d6ea;\n  padding: 3px 8px;\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.hammer-staged-edits__items {\n  display: grid;\n  gap: 0;\n}\n\n.hammer-staged-edits__item {\n  background: transparent;\n  padding: 10px 12px;\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.hammer-staged-edits__item + .hammer-staged-edits__item {\n  border-top: 1px solid rgba(148, 163, 184, 0.12);\n}\n\n.hammer-staged-edits__item-button {\n  border: none;\n  background: transparent;\n  color: inherit;\n  cursor: pointer;\n  padding: 0;\n  text-align: left;\n  flex: 1 1 220px;\n  min-width: 0;\n}\n\n.hammer-staged-edits__item-button:hover .hammer-staged-edits__item-label,\n.hammer-staged-edits__item-button:focus-visible .hammer-staged-edits__item-label {\n  color: #f8fbff;\n}\n\n.hammer-staged-edits__item-button:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.28);\n  border-radius: 8px;\n}\n\n.hammer-staged-edits__item-main {\n  display: grid;\n  gap: 4px;\n}\n\n.hammer-staged-edits__item-label {\n  color: #dbe8ff;\n  font-size: 13px;\n}\n\n.hammer-staged-edits__item-context,\n.hammer-staged-edits__item-detail {\n  color: #c8d6ea;\n  font-size: 12px;\n  opacity: 0.72;\n}\n\n.hammer-staged-edits__footer {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.hammer-asset-card {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 10px;\n  background: rgba(2, 6, 23, 0.42);\n  padding: 10px 12px;\n  display: grid;\n  gap: 6px;\n}\n\n.hammer-asset-card__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.hammer-asset-card__meta-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  gap: 8px;\n}\n\n.hammer-assets-context,\n.hammer-assets-empty-state {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 10px;\n  background: rgba(2, 6, 23, 0.32);\n  padding: 10px 12px;\n  display: grid;\n  gap: 10px;\n}\n\n.hammer-assets-context__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.hammer-workflow-grid {\n  display: grid;\n  gap: 10px;\n}\n\n.hammer-workflow-card {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 12px;\n  background: rgba(15, 23, 42, 0.48);\n  padding: 12px;\n  display: grid;\n  gap: 10px;\n}\n\n.hammer-workflow-card__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.hammer-workflow-card__title {\n  margin: 0;\n  font-size: 15px;\n  color: #dbe8ff;\n}\n\n.hammer-workflow-card__meta {\n  display: grid;\n  gap: 6px;\n}\n\n.hammer-workflow-status {\n  border-radius: 999px;\n  border: 1px solid rgba(148, 163, 184, 0.24);\n  padding: 3px 9px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.03em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n.hammer-workflow-status.is-ready {\n  border-color: rgba(56, 189, 248, 0.34);\n  background: rgba(14, 165, 233, 0.16);\n  color: #bae6fd;\n}\n\n.hammer-workflow-status.is-active {\n  border-color: rgba(52, 211, 153, 0.34);\n  background: rgba(16, 185, 129, 0.16);\n  color: #a7f3d0;\n}\n\n.hammer-workflow-status.is-blocked {\n  border-color: rgba(245, 158, 11, 0.34);\n  background: rgba(245, 158, 11, 0.16);\n  color: #fde68a;\n}\n\n.hammer-workflow-status.is-future {\n  border-color: rgba(129, 140, 248, 0.34);\n  background: rgba(99, 102, 241, 0.16);\n  color: #c7d2fe;\n}\n\n.hammer-selection-summary {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 12px;\n  background: rgba(15, 23, 42, 0.48);\n  padding: 12px;\n  display: grid;\n  gap: 10px;\n}\n\n.hammer-selection-summary__head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.hammer-selection-summary__eyebrow {\n  font-size: 11px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: rgba(200, 214, 234, 0.76);\n}\n\n.hammer-selection-summary__title {\n  color: #dbe8ff;\n  font-size: 15px;\n}\n\n.hammer-polish-focus,\n.hammer-audio-focus {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 12px;\n  background: rgba(2, 6, 23, 0.42);\n  padding: 12px;\n  display: grid;\n  gap: 10px;\n}\n\n.hammer-polish-focus__head,\n.hammer-polish-output__head,\n.hammer-audio-focus__head,\n.hammer-audio-output__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.hammer-polish-output,\n.hammer-audio-output {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 12px;\n  background: rgba(2, 6, 23, 0.42);\n  padding: 12px;\n  display: grid;\n  gap: 10px;\n}\n\n.hammer-polish-output__list,\n.hammer-audio-output__list {\n  margin: 0;\n  padding-left: 18px;\n  display: grid;\n  gap: 6px;\n  color: #dbe8ff;\n  font-size: 13px;\n}\n\n.hammer-script-panel {\n  display: grid;\n  gap: 8px;\n  min-height: 0;\n}\n\n.hammer-script-panel__selection {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 10px;\n  background: rgba(15, 23, 42, 0.48);\n  padding: 8px 10px;\n  display: grid;\n  gap: 8px;\n}\n\n.hammer-script-panel__list {\n  display: grid;\n  gap: 8px;\n  overflow: auto;\n  min-height: 0;\n  align-content: start;\n}\n\n.hammer-script-row__button {\n  border: none;\n  background: transparent;\n  text-align: left;\n  padding: 0;\n  display: grid;\n  gap: 6px;\n  color: inherit;\n  cursor: pointer;\n}\n\n.hammer-script-row__button:focus-visible {\n  outline: none;\n}\n\n.hammer-script-row__meta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.hammer-script-row__playhead {\n  font-size: 11px;\n  font-weight: 600;\n  color: #99f6e4;\n}\n\n.hammer-script-row {\n  position: relative;\n}\n\n.hammer-script-row.is-revealed {\n  animation: hammer-script-row-reveal 900ms ease;\n}\n\n.hammer-script-row__status-list {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.hammer-script-row__status-pill {\n  border-radius: 999px;\n  border: 1px solid rgba(148, 163, 184, 0.24);\n  background: rgba(15, 23, 42, 0.76);\n  color: #dbe8ff;\n  padding: 3px 8px;\n  font-size: 11px;\n  font-weight: 600;\n  line-height: 1.2;\n  white-space: nowrap;\n}\n\n.hammer-script-row__status-pill.is-delete {\n  border-color: rgba(239, 68, 68, 0.3);\n  background: rgba(127, 29, 29, 0.28);\n  color: #fca5a5;\n}\n\n.hammer-script-row__status-pill.is-mute {\n  border-color: rgba(245, 158, 11, 0.28);\n  background: rgba(120, 53, 15, 0.26);\n  color: #fde68a;\n}\n\n.hammer-script-row__status-pill.is-trim {\n  border-color: rgba(129, 140, 248, 0.28);\n  background: rgba(67, 56, 202, 0.2);\n  color: #c4b5fd;\n}\n\n.hammer-script-row__status-pill.is-split {\n  border-color: rgba(99, 102, 241, 0.28);\n  background: rgba(49, 46, 129, 0.26);\n  color: #c7d2fe;\n}\n\n.hammer-script-row__status-pill.is-merge {\n  border-color: rgba(56, 189, 248, 0.28);\n  background: rgba(8, 47, 73, 0.3);\n  color: #bae6fd;\n}\n\n.hammer-script-blocks {\n  display: grid;\n  gap: 6px;\n}\n\n.hammer-script-block {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 8px;\n  padding: 6px 8px;\n  background: rgba(2, 6, 23, 0.32);\n  display: grid;\n  gap: 3px;\n}\n\n@keyframes hammer-script-row-reveal {\n  0% {\n    outline: 0 solid rgba(96, 165, 250, 0);\n    outline-offset: 0;\n  }\n\n  30% {\n    outline: 2px solid rgba(96, 165, 250, 0.7);\n    outline-offset: 0;\n  }\n\n  100% {\n    outline: 2px solid rgba(96, 165, 250, 0);\n    outline-offset: 6px;\n  }\n}\n\n.hammer-monitor {\n  border: 1px solid rgba(148, 163, 184, 0.24);\n  border-radius: 16px;\n  overflow: hidden;\n  background: rgba(3, 7, 18, 0.92);\n  display: grid;\n  width: 100%;\n  justify-self: stretch;\n}\n\n.hammer-monitor__chrome {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n  padding: 7px 10px;\n  border-bottom: 1px solid rgba(148, 163, 184, 0.18);\n  background: rgba(15, 23, 42, 0.82);\n}\n\n.hammer-monitor__surface {\n  width: 100%;\n  aspect-ratio: 16 / 9;\n  display: grid;\n  place-items: center;\n  min-height: clamp(240px, 34vh, 480px);\n  max-height: min(56vh, 520px);\n  padding: clamp(14px, 2.6vw, 22px);\n  background:\n    radial-gradient(circle at top, rgba(59, 130, 246, 0.18), transparent 45%),\n    linear-gradient(180deg, rgba(15, 23, 42, 0.88), rgba(2, 6, 23, 0.96));\n}\n\n.hammer-monitor__surface.has-media {\n  padding: 0;\n  background: #020617;\n}\n\n.hammer-monitor__center {\n  display: grid;\n  gap: 10px;\n  justify-items: center;\n  text-align: center;\n  max-width: 440px;\n}\n\n.hammer-monitor__media {\n  width: auto;\n  height: auto;\n  max-width: 100%;\n  max-height: 100%;\n  display: block;\n  background: #020617;\n  object-fit: contain;\n  object-position: center;\n  place-self: center;\n}\n\n.hammer-monitor__audio {\n  width: min(100%, 460px);\n}\n\n.hammer-monitor__eyebrow {\n  font-size: 11px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: rgba(191, 219, 254, 0.76);\n}\n\n.hammer-monitor__title {\n  margin: 0;\n  font-size: 24px;\n  line-height: 1.1;\n  color: #f8fafc;\n}\n\n.hammer-monitor__hint {\n  font-size: 13px;\n  line-height: 1.45;\n  color: rgba(226, 232, 240, 0.82);\n}\n\n.hammer-preview-transport {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 12px;\n  background: rgba(15, 23, 42, 0.52);\n  padding: 10px;\n  display: grid;\n  gap: 8px;\n  width: 100%;\n  justify-self: stretch;\n}\n\n.hammer-preview-transport__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.hammer-preview-transport input[type=\"range\"] {\n  width: 100%;\n}\n\n.hammer-audio-hidden {\n  display: none;\n}\n\n.hammer-preview-panel {\n  align-self: start;\n  overflow: hidden;\n}\n\n.hammer-preview-panel__body {\n  display: grid;\n  gap: 8px;\n  align-content: start;\n  overflow: auto;\n}\n\n.hammer-dev-media-loader {\n  width: 100%;\n  border: 1px solid rgba(148, 163, 184, 0.2);\n  border-radius: 12px;\n  background: rgba(15, 23, 42, 0.56);\n  padding: 9px;\n  display: grid;\n  gap: 8px;\n}\n\n.hammer-dev-media-loader__head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.hammer-dev-media-loader__context {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 6px;\n}\n\n.hammer-dev-media-loader__list {\n  display: grid;\n  gap: 6px;\n  max-height: 136px;\n  overflow: auto;\n  padding-right: 4px;\n}\n\n.hammer-dev-media-loader__empty {\n  border: 1px dashed rgba(148, 163, 184, 0.22);\n  border-radius: 10px;\n  background: rgba(2, 6, 23, 0.34);\n  padding: 10px;\n  color: rgba(200, 214, 234, 0.86);\n  font-size: 12px;\n}\n\n.hammer-dev-media-loader__empty.is-error {\n  border-color: rgba(248, 113, 113, 0.28);\n  color: #fecaca;\n}\n\n.hammer-dev-media-loader__item {\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  border-radius: 10px;\n  background: rgba(2, 6, 23, 0.34);\n  color: inherit;\n  padding: 7px 9px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  cursor: pointer;\n  text-align: left;\n  transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;\n}\n\n.hammer-dev-media-loader__item:hover {\n  border-color: rgba(96, 165, 250, 0.34);\n  background: rgba(15, 23, 42, 0.62);\n  transform: translateY(-1px);\n}\n\n.hammer-dev-media-loader__item.is-active {\n  border-color: rgba(96, 165, 250, 0.42);\n  background: rgba(30, 41, 59, 0.84);\n}\n\n.hammer-dev-media-loader__item:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.3);\n}\n\n.hammer-dev-media-loader__item-main {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n}\n\n.hammer-dev-media-loader__item-title {\n  color: #dbe8ff;\n  font-size: 13px;\n}\n\n.hammer-dev-media-loader__item-meta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n  font-size: 11px;\n  color: rgba(200, 214, 234, 0.76);\n}\n\n.hammer-dev-media-loader__item-status {\n  font-size: 12px;\n  color: rgba(191, 219, 254, 0.88);\n}\n\n.hammer-dev-media-loader__context .hammer-copy-sm,\n.hammer-preview-truth-item .hammer-copy-sm {\n  display: -webkit-box;\n  overflow: hidden;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 1;\n}\n\n.hammer-preview-stage {\n  display: grid;\n  gap: 8px;\n  align-content: start;\n  justify-items: stretch;\n  width: 100%;\n  min-height: 100%;\n}\n\n.hammer-preview-stage__context {\n  width: 100%;\n  display: grid;\n  grid-template-columns: minmax(320px, 1.15fr) minmax(280px, 0.95fr);\n  gap: 8px;\n  align-items: start;\n}\n\n.hammer-preview-feedback {\n  width: 100%;\n}\n\n.hammer-preview-card {\n  width: 100%;\n  border: 1px solid rgba(14