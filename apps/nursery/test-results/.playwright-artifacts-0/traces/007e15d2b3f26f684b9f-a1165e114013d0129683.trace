nt: space-between;\n  gap: 10px;\n  align-items: baseline;\n  flex-wrap: wrap;\n}\n\n.trs-card__title {\n  font-weight: 700;\n}\n\n.trs-create {\n  max-width: 520px;\n}\n\n.trs-create__actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.trs-field {\n  display: grid;\n  gap: 4px;\n}\n\n.trs-field__label {\n  font-size: 12px;\n  opacity: 0.75;\n}\n\n.trs-message {\n  font-size: 13px;\n}\n\n.trs-message--subtle {\n  opacity: 0.72;\n}\n\n.trs-message--warning {\n  color: #ffd599;\n}\n\n.trs-message--error {\n  color: #ffb3b3;\n}\n\n.trs-message--success {\n  color: #b3f4c8;\n}\n\n.trs-sessions-list {\n  display: grid;\n  gap: 8px;\n}\n\n.trs-session-row {\n  display: flex;\n  gap: 8px;\n  align-items: stretch;\n}\n\n.trs-session-row__select {\n  text-align: left;\n  border-radius: 8px;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  background: rgba(0, 0, 0, 0.18);\n  color: inherit;\n  padding: 8px 10px;\n  flex: 1;\n}\n\n.trs-session-row__select--active {\n  border-color: rgba(255, 255, 255, 0.55);\n  background: rgba(255, 255, 255, 0.14);\n}\n\n.trs-session-row__title {\n  font-weight: 700;\n}\n\n.trs-session-row__date {\n  font-size: 12px;\n  opacity: 0.72;\n}\n\n.trs-session-row__delete {\n  border-radius: 8px;\n  border: 1px solid rgba(255, 120, 120, 0.45);\n  background: rgba(120, 0, 0, 0.28);\n  color: inherit;\n  padding: 8px 10px;\n  min-width: 88px;\n}\n\n.trs-detail-header {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  align-items: baseline;\n  flex-wrap: wrap;\n}\n\n.trs-detail__meta {\n  font-size: 12px;\n  opacity: 0.72;\n}\n\n.trs-detail-grid {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n}\n\n.trs-subcard {\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 10px;\n  padding: 10px;\n  background: rgba(0, 0, 0, 0.2);\n  display: grid;\n  gap: 10px;\n  align-content: start;\n}\n\n.trs-subcard__title {\n  font-weight: 700;\n}\n\n.trs-list-