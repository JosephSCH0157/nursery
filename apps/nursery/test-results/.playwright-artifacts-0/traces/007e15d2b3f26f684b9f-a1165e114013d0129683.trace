ze: 11px;\n  font-weight: 700;\n  cursor: pointer;\n  display: grid;\n  align-content: center;\n  text-align: left;\n  box-shadow: none;\n  transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease, opacity 140ms ease;\n}\n\n.hammer-timeline-clip.is-editable {\n  cursor: pointer;\n}\n\n.hammer-timeline-clip:hover {\n  transform: translateY(-1px);\n}\n\n.hammer-timeline-clip.is-selected {\n  border-color: rgba(219, 234, 254, 0.9);\n  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.28);\n}\n\n.hammer-timeline-clip.is-active {\n  transform: translateY(-1px);\n  box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.28);\n}\n\n.hammer-timeline-clip.has-trim-handles {\n  padding-left: 14px;\n  padding-right: 14px;\n}\n\n.hammer-timeline-clip:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px rgba(248, 250, 252, 0.28), 0 0 0 4px rgba(96, 165, 250, 0.28);\n}\n\n.hammer-timeline-clip__trim-handle {\n  position: absolute;\n  top: 6px;\n  bottom: 6px;\n  width: 4px;\n  border-radius: 999px;\n  background: rgba(248, 250, 252, 0.82);\n  box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.25);\n}\n\n.hammer-timeline-clip__trim-handle--start {\n  left: 4px;\n}\n\n.hammer-timeline-clip__trim-handle--end {\n  right: 4px;\n}\n\n.hammer-timeline-clip__ripple-cue {\n  position: absolute;\n  top: -7px;\n  right: -10px;\n  border-radius: 999px;\n  border: 1px dashed rgba(248, 250, 252, 0.54);\n  background: rgba(15, 23, 42, 0.92);\n  color: #dbe8ff;\n  padding: 1px 6px;\n  font-size: 9px;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.hammer-track-viewport__playhead {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 2px;\n  background: #f8fafc;\n  box-shadow: 0 0 0 1px rgba(248, 250, 252, 0.28);\n}\n\n.hammer-track-viewport__playhead--ruler {\n  top: auto;\n  bottom: -1px;\n  height: 18px;\n}\n"],["STYLE",{},".hammer-launch-stub {\n  display: grid;\n  gap: 16px;\n  color: #dbe8ff;\n}\n\n.hammer-launch-stub__header {\n  display: flex;\n  align-items: flex-sta