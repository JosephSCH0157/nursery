k-border);\r\n  border-radius: 10px;\r\n  background: var(--barstock-surface);\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.barstock-main__active-project-title {\r\n  font-size: 13px;\r\n  opacity: 0.84;\r\n}\r\n\r\n.barstock-main__active-project-meta {\r\n  font-size: 12px;\r\n  opacity: 0.8;\r\n}\r\n\r\n.barstock-main__active-project-actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.barstock-main__launch-button {\r\n  padding: 10px 14px;\r\n  font-weight: 700;\r\n}\r\n\r\n.barstock-main__toast {\r\n  margin-top: 10px;\r\n  padding: 8px 10px;\r\n  border: 1px solid var(--barstock-border);\r\n  border-radius: 8px;\r\n  background: var(--barstock-surface);\r\n}\r\n\r\n.barstock-main__composer {\r\n  display: flex;\r\n  gap: 10px;\r\n  margin-top: 16px;\r\n}\r\n\r\n.barstock-main__composer-textarea {\r\n  flex: 1;\r\n  padding: 12px;\r\n  font-size: 14px;\r\n}\r\n\r\n.barstock-main__composer-button {\r\n  padding: 10px 14px;\r\n  font-weight: 600;\r\n}\r\n\r\n.barstock-main__filters {\r\n  display: flex;\r\n  gap: 10px;\r\n  margin-top: 12px;\r\n  align-items: center;\r\n}\r\n\r\n.barstock-main__filter-search {\r\n  flex: 1;\r\n  padding: 10px;\r\n}\r\n\r\n.barstock-main__filter-status {\r\n  padding: 10px;\r\n}\r\n\r\n.barstock-main__filter-checkbox {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 12px;\r\n  opacity: 0.85;\r\n}\r\n\r\n.barstock-main__tag-filter {\r\n  margin-top: 8px;\r\n  font-size: 12px;\r\n  opacity: 0.8;\r\n}\r\n\r\n.barstock-main__spark-list {\r\n  margin-top: 18px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.barstock-main__empty {\r\n  opacity: 0.75;\r\n  margin-top: 8px;\r\n}\r\n\r\n.barstock-spark-card {\r\n  border: 1px solid var(--barstock-border);\r\n  border-radius: 10px;\r\n  padding: 12px;\r\n  background: var(--barstock-surface);\r\n}\r\n\r\n.barstock-spark-card.is-graduated-dimmed {\r\n  opacity: 0.82;\r\n}\r\n\r\n.barstock-spark-card__head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n}\r\n\r\n.barstock-spark-card__meta {\r\n  opacity: 0.7;\r\n  font-size: 12px;\r\n}\r\n\r\n.barstock-spark-card__actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.barstock-spark-card__graduated-badge {\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.2px;\r\n  border: 1px solid var(--barstock-border);\r\n  border-radius: 999px;\r\n  padding: 2px 8px;\r\n  opacity: 0.9;\r\n}\r\n\r\n.barstock-spark-card__compact-select {\r\n  padding: 4px 6px;\r\n}\r\n\r\n.barstock-spark-card__edit-textarea {\r\n  width: 100%;\r\n  margin-top: 10px;\r\n  padding: 10px;\r\n  font-size: 14px;\r\n}\r\n\r\n.barstock-spark-card__body {\r\n  margin: 10px 0 0;\r\n  white-space: pre-wrap;\r\n  font-family: inherit;\r\n}\r\n\r\n.barstock-spark-card__tags {\r\n  margin-top: 10px;\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.barstock-spark-card__tag-button {\r\n  border: 1px solid var(--barstock-border);\r\n  border-radius: 999px;\r\n  padding: 4px 10px;\r\n  font-size: 12px;\r\n  opacity: 0.9;\r\n  background: rgba(26, 38, 61, 0.65);\r\n}\r\n\r\n.barstock-sidebar-item {\r\n  text-align: left;\r\n  width: 100%;\r\n  padding: 8px 10px;\r\n  border-radius: 10px;\r\n  border: 1px solid var(--barstock-border);\r\n  font-weight: 600;\r\n  opacity: 0.85;\r\n  background: transparent;\r\n}\r\n\r\n.barstock-sidebar-item.is-active {\r\n  font-weight: 800;\r\n  opacity: 1;\r\n  background: var(--barstock-surface-strong);\r\n}\r\n\r\n@media (max-width: 980px) {\r\n  .barstock-layout {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .barstock-sidebar {\r\n    border-right: 0;\r\n    border-bottom: 1px solid var(--barstock-border);\r\n  }\r\n\r\n  .barstock-main {\r\n    max-width: none;\r\n  }\r\n\r\n  .barstock-main__composer,\r\n  .barstock-main__filters {\r\n    flex-wrap: wrap;\r\n  }\r\n}\r\n"],["STYLE",{},".hs-sectioned-body {\r\n  display: grid;\r\n  gap: 6px;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.hs-divider {\r\n  border-color: rgba(148, 163, 184, 0.35);\r\n}\r\n\r\n.hs-shell {\r\n  padding: 24px;\r\n  display: grid;\r\n  gap: 16px;\r\n}\r\n\r\n.hs-shell-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);\r\n  gap: 16px;\r\n  align-items: start;\r\n}\r\n\r\n.hs-rail {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 10px;\r\n  padding: 12px;\r\n  background: var(--forge-bg-elevated, #fff);\r\n  display: grid;\r\n  gap: 14px;\r\n}\r\n\r\n.hs-rail-header {\r\n  display: grid;\r\n  gap: 4px;\r\n}\r\n\r\n.hs-rail-title {\r\n  font-weight: 700;\r\n}\r\n\r\n.hs-rail-meta {\r\n  font-size: 12px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hs-rail-section {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-rail-heading {\r\n  font-size: 11px;\r\n  opacity: 0.6;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.hs-rail-label {\r\n  font-size: 12px;\r\n  opacity: 0.8;\r\n}\r\n\r\n.hs-rail-sort {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-ready-record-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-ready-record-count {\r\n  margin-left: 6px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  opacity: 0.8;\r\n}\r\n\r\n.hs-ready-record-chips {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.hs-ready-chip {\r\n  border: 1px solid var(--forge-border, #ddd);\r\n  border-radius: 999px;\r\n  padding: 2px 8px;\r\n  font-size: 11px;\r\n  background: transparent;\r\n}\r\n\r\n.hs-ready-chip.is-active {\r\n  background: rgba(85, 119, 255, 0.08);\r\n  border-color: #557;\r\n}\r\n\r\n.hs-ready-record-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.hs-ready-record-groups {\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.hs-ready-record-group {\r\n  display: grid;\r\n  