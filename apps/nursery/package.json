{
  "name": "nursery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "20.20.0" },
  "volta": { "node": "20.20.0" },
  "scripts": {
    "sync:anvil": "node scripts/sync-anvil-dist.mjs",
    "gen:forge-nav": "tsx scripts/generate-forge-nav.ts",
    "predev": "pnpm sync:anvil && pnpm gen:forge-nav && pnpm --filter @forge/shared build && pnpm --filter @forge/tongs build",
    "dev": "node scripts/run-vite.mjs --configLoader runner",
    "prebuild": "pnpm sync:anvil && pnpm gen:forge-nav && pnpm --filter @forge/shared build && pnpm --filter @forge/tongs build",
    "build": "tsc -b && node scripts/run-vite.mjs build --configLoader runner && node scripts/verify-hearth-bundle-budget.mjs",
    "verify:hearth-bundle": "node scripts/verify-hearth-bundle-budget.mjs",
    "prebuild:hammer-integration": "pnpm --filter @forge/shared build && pnpm --filter @forge/tongs build",
    "build:hammer-integration": "tsc -p tsconfig.hammer-integration.json --noEmit && vite build --config vite.hammer.config.ts --configLoader runner && node scripts/verify-hammer-production-build.mjs",
    "types": "pnpm typecheck",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json --pretty false",
    "lint": "eslint .",
    "preview": "node scripts/run-vite.mjs preview --configLoader runner",
    "smoke:tongs-commit-api": "node scripts/smoke-tongs-commit-api.mjs",
    "test:hammer-boundary": "tsx tests/hammer-runtime-boundary.test.mts",
    "test:hammer-open-hydration": "tsx tests/hammer-open-hydration.test.mts",
    "test:hammer-transcript-preflight": "tsx tests/hammer-transcript-policy-preflight.test.mts",
    "test:hammer-cleanup-preflight": "tsx tests/hammer-transcript-cleanup-preflight.test.mts",
    "test:hammer-visual-preflight": "tsx tests/hammer-visual-assist-preflight.test.mts",
    "test:hammer-studio-rack-render-route": "tsx tests/hammer-studio-rack-render-route.test.mts",
    "test:quench-metadata-preflight": "tsx tests/quench-metadata-preflight.test.mts",
    "test:handoff": "tsx tests/forge-handoff-validation.test.mts",
    "test:henry-context": "tsx tests/henry-context-engine.test.mts",
    "test:henry-actions": "tsx tests/henry-quick-actions.test.mts",
    "test:henry-suppression": "tsx tests/henry-suppression.test.mts",
    "test:hearth-runtime": "tsx tests/hearth-ai-runtime.test.mts",
    "test:forge-ai-router": "tsx tests/forge-ai-policy-router.test.mts",
    "test:ledger": "tsx tests/ledger-costs.test.mts",
    "test:thumbnail-ledger": "tsx --test tests/thumbnail-ledger-intelligence.test.mts",
    "test:brand-library": "tsx --test tests/brand-library-authority.test.mts",
    "test:admin-panel": "tsx tests/admin-panel.test.mts",
    "test:youtube-publishing-connection": "tsx tests/youtube-publishing-connection.test.mts",
    "test:workspace-label": "tsx tests/workspace-label.test.mts",
    "test:workspace-access-union": "tsx tests/workspace-access-union.test.mts",
    "test": "node scripts/run-tests.mjs",
    "verify:ai-policy-live": "tsx scripts/verify-ai-policy-live.mts",
    "verify:playwright:auth": "tsx scripts/verify-playwright-auth-state.mts",
    "browser:fixtures:provision": "tsx scripts/browser-fixtures.mts provision",
    "browser:fixtures:verify": "tsx scripts/browser-fixtures.mts verify",
    "browser:fixtures:clean": "tsx scripts/browser-fixtures.mts clean",
    "browser:prepare": "pnpm browser:fixtures:provision && pnpm browser:fixtures:verify",
    "test:browser-fixtures": "tsx --test tests/browser-fixture-authority.test.mts",
    "test:preview-performance-preflight": "tsx tests/hammer-preview-performance-preflight.test.mts",
    "preview-performance:prepare": "tsx scripts/hammer-preview-performance-preflight.mts",
    "test:playwright:hammer-preview-performance": "playwright test -c playwright.hammer-preview-performance.config.ts playwright/hammer.preview-performance.spec.ts",
    "verify:hammer-preview-performance-receipts": "tsx scripts/verify-hammer-preview-performance-receipts.mts",
    "generate:playwright:auth": "tsx scripts/generate-playwright-auth-state.mts && pnpm verify:playwright:auth",
    "preflight:hearth-phase4": "tsx scripts/verify-hearth-phase4-fixtures.mts",
    "test:playwright:auth": "playwright test -c playwright.config.ts playwright/auth.capture.spec.ts --headed --workers=1 && pnpm verify:playwright:auth",
    "test:playwright:login-password": "playwright test -c playwright.config.ts playwright/login.password-visibility.spec.ts --workers=1",
    "test:playwright:adaptive-style": "playwright test -c playwright.config.ts playwright/adaptive_style_ui_matrix.spec.ts --workers=1",
    "test:playwright:org-sharing": "playwright test -c playwright.config.ts playwright/org.workspace-sharing.smoke.spec.ts --workers=1",
    "test:playwright:barstock-reconciliation": "playwright test -c playwright.config.ts playwright/barstock.reconciliation.spec.ts --workers=1",
    "test:playwright:barstock-handoff": "playwright test -c playwright.config.ts playwright/hearth.barstock-fresh-auth-handoff.spec.ts --workers=1",
    "test:playwright:surgical": "playwright test -c playwright.config.ts playwright/library_to_session_switching.spec.ts",
    "test:playwright:hammer-triad-lock": "playwright test -c playwright.config.ts playwright/hammer.triad-lock.spec.ts --workers=1",
    "test:playwright:hammer-visual-authority-feedback": "playwright test -c playwright.config.ts playwright/hammer.visual-authority-feedback.spec.ts --workers=1",
    "test:playwright:hearth-phase4": "pnpm preflight:hearth-phase4 && playwright test -c playwright.config.ts playwright/hearth.phase4.*.spec.ts",
    "test:playwright:hearth-phase5-slice1": "pnpm preflight:hearth-phase4 && playwright test -c playwright.config.ts playwright/hearth.phase5.image-map.spec.ts",
    "test:playwright:hearth-research": "playwright test -c playwright.config.ts playwright/hearth.research-isolation.spec.ts --workers=1",
    "test:playwright:openai-billing-evidence": "playwright test -c playwright.config.ts playwright/openai.billing-evidence-isolation.spec.ts --workers=1",
    "test:playwright:thumbnail-v3": "playwright test -c playwright.config.ts playwright/hearth.thumbnail-v3.spec.ts --workers=1",
    "test:playwright:brand-media-live": "playwright test -c playwright.config.ts playwright/brand-media-live.spec.ts --workers=1"
  },
  "dependencies": {
    "@forge/bellows": "workspace:*",
    "@forge/shared": "workspace:*",
    "@forge/tongs": "workspace:*",
    "@forge/ui-mobile": "workspace:*",
    "@huggingface/inference": "^4.13.15",
    "@runwayml/sdk": "4.13.1",
    "@supabase/supabase-js": "^2.98.0",
    "fflate": "^0.8.2",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.57.2",
    "vite": "7.2.4"
  }
}
