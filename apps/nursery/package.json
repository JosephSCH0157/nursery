{
  "name": "nursery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:anvil": "node scripts/sync-anvil-dist.mjs",
    "gen:forge-nav": "tsx scripts/generate-forge-nav.ts",
    "predev": "pnpm sync:anvil && pnpm gen:forge-nav && pnpm --filter @forge/shared build && pnpm --filter @forge/tongs build",
    "dev": "node scripts/run-vite.mjs --configLoader runner",
    "prebuild": "pnpm sync:anvil && pnpm gen:forge-nav && pnpm --filter @forge/shared build",
    "build": "tsc -b && node scripts/run-vite.mjs build --configLoader runner",
    "types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "preview": "node scripts/run-vite.mjs preview --configLoader runner",
    "smoke:tongs-commit-api": "node scripts/smoke-tongs-commit-api.mjs",
    "test:hammer-boundary": "tsx tests/hammer-runtime-boundary.test.mts",
    "test:handoff": "tsx tests/forge-handoff-validation.test.mts",
    "test:henry-context": "tsx tests/henry-context-engine.test.mts",
    "test:henry-actions": "tsx tests/henry-quick-actions.test.mts",
    "test:henry-suppression": "tsx tests/henry-suppression.test.mts",
    "test:hearth-runtime": "tsx tests/hearth-ai-runtime.test.mts",
    "verify:playwright:auth": "tsx scripts/verify-playwright-auth-state.mts",
    "generate:playwright:auth": "tsx scripts/generate-playwright-auth-state.mts && pnpm verify:playwright:auth",
    "preflight:hearth-phase4": "tsx scripts/verify-hearth-phase4-fixtures.mts",
    "test:playwright:auth": "playwright test -c playwright.config.ts playwright/auth.capture.spec.ts --headed --workers=1 && pnpm verify:playwright:auth",
    "test:playwright:surgical": "playwright test -c playwright.config.ts playwright/library_to_session_switching.spec.ts",
    "test:playwright:hammer-triad-lock": "playwright test -c playwright.config.ts playwright/hammer.triad-lock.spec.ts --workers=1",
    "test:playwright:hearth-phase4": "pnpm preflight:hearth-phase4 && playwright test -c playwright.config.ts playwright/hearth.phase4.*.spec.ts",
    "test:playwright:hearth-phase5-slice1": "pnpm preflight:hearth-phase4 && playwright test -c playwright.config.ts playwright/hearth.phase5.image-map.spec.ts"
  },
  "dependencies": {
    "@forge/bellows": "workspace:*",
    "@forge/hearth": "workspace:*",
    "@forge/shared": "workspace:*",
    "@forge/tongs": "workspace:*",
    "@forge/ui-mobile": "workspace:*",
    "@supabase/supabase-js": "^2.98.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.57.1",
    "vite": "7.2.4"
  }
}
