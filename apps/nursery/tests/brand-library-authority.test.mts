import assert from "node:assert/strict";import test from "node:test";import {readFile} from "node:fs/promises";
import {canonicalBrandContent,validateBrandRules,type BrandRules} from "@forge/shared";
const rules:BrandRules={public_identity:{program_name:"Forge Show",tagline:"Truthfully useful"},palette:{primary:"#111827",secondary:"#f8fafc",accent:"#f97316"},typography:{heading_family:"bold_sans",body_family:"sans-serif",heading_weight:700,body_weight:400},logo:{placement:"bottom_right",watermark_opacity:.7},audio:{music_volume:.2,ducking:.35},asset_revision_ids:{}};
test("canonical brand content excludes profile lifecycle and default state",()=>{const content=canonicalBrandContent(rules) as unknown as Record<string,unknown>;assert.equal(content.internal_label,undefined);assert.equal(content.archived_at,undefined);assert.equal(content.is_default,undefined);assert.deepEqual(canonicalBrandContent(rules),rules);});
test("render-affecting rules validate without uploaded fonts or deferred behavior",()=>{assert.deepEqual(validateBrandRules(rules),[]);assert.match(validateBrandRules({...rules,palette:{...rules.palette,accent:"orange"}})[0]??"",/hex/);});
test("migration separates lifecycle, immutable content, defaults, assets, and workpiece bindings",async()=>{const sql=await readFile(new URL("../../../supabase/migrations/20260717200000_tongs_workspace_brand_library.sql",import.meta.url),"utf8");for(const name of ["brand_profiles","brand_profile_revisions","workspace_default_brand_profiles","brand_assets","brand_asset_revisions","workpiece_brand_bindings","workpiece_brand_binding_operations"])assert.match(sql,new RegExp(`create table tongs\\.${name}`));assert.match(sql,/resolve_workpiece_brand_default/);assert.match(sql,/mutate_workpiece_brand_binding/);assert.match(sql,/pg_advisory_xact_lock/);assert.match(sql,/revision_conflict/);assert.match(sql,/target_not_bindable/);});
test("hardening migration returns one existing binding after concurrent resolution",async()=>{const sql=await readFile(new URL("../../../supabase/migrations/20260717203000_tongs_brand_bindability_and_resolution_hardening.sql",import.meta.url),"utf8");assert.match(sql,/existing_binding/);assert.match(sql,/brand_revision_is_bindable/);assert.match(sql,/jsonb_each_text/);assert.match(sql,/Operation identity was reused/);});
test("Brand Library projection exposes the shared revision contract",async()=>{const sql=await readFile(new URL("../../../supabase/migrations/20260718090000_tongs_brand_library_projection_contract.sql",import.meta.url),"utf8");assert.match(sql,/'rules',r\.rules_json/);assert.match(sql,/'validation',r\.validation_json/);assert.match(sql,/'verified_at',r\.verified_at/);assert.match(sql,/'verification_version',r\.verification_version/);});
test("brand media roles distinguish audio and video without weakening legacy identities",async()=>{const sql=await readFile(new URL("../../../supabase/migrations/20260720120000_tongs_brand_media_roles.sql",import.meta.url),"utf8");for(const role of ["audio_intro","audio_outro","video_intro","video_outro","intro_media","outro_media"])assert.match(sql,new RegExp(`'${role}'`));assert.match(sql,/role-neutral/);});
test("creator Brand Library presents cards, capability readiness, and ordinary save language",async()=>{const source=await readFile(new URL("../src/routes/TongsBranding.tsx",import.meta.url),"utf8");for(const phrase of ["Create brand","Workspace default","Thumbnail branding","Audio-only intro","Audio-only outro","Video intro","Video outro","Save brand changes","Version history","Advanced details"])assert.match(source,new RegExp(phrase));for(const leak of ["Save immutable brand revision","Zero or one workspace default is valid","Archive and explicitly clear default","Asset role"])assert.doesNotMatch(source,new RegExp(leak));});
